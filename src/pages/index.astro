---
import Immersive from "../layouts/Immersive.astro";
import { PERFIL, VIDEOS, SERVICIOS, PROCESO, CONTACTO } from "../data/portfolio";

/* Datos de reproducción de cada video (nada se aloja aquí; se incrusta) */
function youtubeThumb(id: string) {
  return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
}
const videos = VIDEOS.map((v) => {
  const esReal = Boolean(v.fuente && v.videoId);
  let thumb = v.thumbnail ?? "";
  let embed = "";
  let enlace = "";
  if (esReal) {
    const id = v.videoId as string;
    if (v.fuente === "youtube") {
      thumb = v.thumbnail ?? youtubeThumb(id);
      embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      enlace = `https://youtu.be/${id}`;
    } else if (v.fuente === "vimeo") {
      embed = `https://player.vimeo.com/video/${id}?autoplay=1`;
      enlace = `https://vimeo.com/${id}`;
    } else {
      enlace = id;
    }
  }
  return { ...v, esReal, thumb, embed, enlace, puedeIncrustar: embed !== "" };
});

const tituloPalabras = PERFIL.titular.replace(/\.$/, "").split(" ");
---

<Immersive>
  <!-- ===================== HERO ===================== -->
  <section class="hero" id="top">
    <div class="hero-inner">
      <div class="hero-kicker" data-hero>
        <span class="tag">{PERFIL.rol}</span>
        <span class="tag tag--accent">{PERFIL.disponibilidad}</span>
      </div>

      <h1 class="hero-title">
        {
          tituloPalabras.map((w) => (
            <span class="word-mask">
              <span class="word">{w}</span>
            </span>
          ))
        }
      </h1>

      <p class="hero-sub" data-hero>{PERFIL.subtitular}</p>
    </div>

    <div class="hero-scroll" data-hero>
      <span>Scroll</span>
      <span class="hero-scroll-line"></span>
    </div>
  </section>

  <!-- ===================== STATEMENT ===================== -->
  <section class="statement">
    <p class="statement-text">
      {
        "No hago anuncios. Hago videos que la gente termina de ver."
          .split(" ")
          .map((w) => (
            <span class="s-word" data-statement>
              {w}{" "}
            </span>
          ))
      }
    </p>
  </section>

  <!-- ===================== TRABAJOS (scroll horizontal) ===================== -->
  <section class="s-trabajos" id="trabajos">
    <div class="trabajos-pin">
      <div class="trabajos-head">
        <span class="eyebrow" data-reveal>01 / Trabajos</span>
        <h2 class="trabajos-title" data-reveal>Videos UGC</h2>
      </div>

      <div class="trabajos-viewport">
        <div class="trabajos-track" id="trabajos-track">
          {
            videos.map((v) => (
              <article class="vcard">
                {v.esReal ? (
                  v.puedeIncrustar ? (
                    <button
                      type="button"
                      class="vmedia"
                      data-embed={v.embed}
                      aria-label={`Reproducir: ${v.titulo ?? "video"}`}
                    >
                      <img src={v.thumb} alt={`Miniatura de ${v.titulo ?? "video"}`} loading="lazy" />
                      <span class="vplay" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      </span>
                    </button>
                  ) : (
                    <a class="vmedia" href={v.enlace} target="_blank" rel="noopener" aria-label={`Ver: ${v.titulo ?? "video"}`}>
                      <img src={v.thumb} alt={`Miniatura de ${v.titulo ?? "video"}`} loading="lazy" />
                      <span class="vplay" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      </span>
                    </a>
                  )
                ) : (
                  <div class="vmedia vmedia--soon">
                    <span class="vplay vplay--ghost" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                    <span class="vsoon">Próximamente</span>
                  </div>
                )}
                <div class="vinfo">
                  {v.categoria && <span class="vcat">{v.categoria}</span>}
                  {v.titulo && <h3 class="vtitle">{v.titulo}</h3>}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICIOS ===================== -->
  <section class="s-servicios" id="servicios">
    <div class="wrap">
      <span class="eyebrow" data-reveal>02 / Servicios</span>
      <h2 class="s-title" data-reveal>Cómo trabajamos</h2>
      <div class="servicios-grid">
        {
          SERVICIOS.map((s) => (
            <article class="scard" data-reveal>
              <div class="scard-top">
                <h3>{s.titulo}</h3>
                <span class="scard-precio">{s.precio}</span>
              </div>
              <p class="scard-desc">{s.descripcion}</p>
              <ul class="scard-list">
                {s.entregables.map((i) => <li>{i}</li>)}
              </ul>
              <a class="scard-cta" href="#contacto" data-scroll>Pedir cotización</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== PROCESO ===================== -->
  <section class="s-proceso">
    <div class="wrap">
      <span class="eyebrow" data-reveal>03 / Proceso</span>
      <h2 class="s-title" data-reveal>De la idea a la entrega</h2>
      <ol class="proceso">
        {
          PROCESO.map((p, i) => (
            <li class="paso" data-reveal>
              <span class="paso-num">{String(i + 1).padStart(2, "0")}</span>
              <div class="paso-body">
                <h3>{p.titulo}</h3>
                <p>{p.descripcion}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== SOBRE MÍ ===================== -->
  <section class="s-sobre">
    <div class="wrap wrap--narrow">
      <span class="eyebrow" data-reveal>04 / Sobre mí</span>
      <div class="sobre-text">
        {PERFIL.sobre_mi.map((p) => <p data-reveal>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ===================== CONTACTO ===================== -->
  <section class="s-contacto" id="contacto">
    <div class="wrap">
      <span class="eyebrow" data-reveal>05 / Contacto</span>
      <h2 class="contacto-big" data-reveal>{CONTACTO.cierre}</h2>
      <div class="contacto-grid">
        <a class="contacto-mail" href={`mailto:${CONTACTO.email}`} data-reveal>{CONTACTO.email}</a>
        <ul class="contacto-redes" data-reveal>
          <li><span>Instagram</span><a href={CONTACTO.instagram.url} target="_blank" rel="noopener">{CONTACTO.instagram.usuario}</a></li>
          <li><span>TikTok</span><a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">{CONTACTO.tiktok.usuario}</a></li>
        </ul>
      </div>
    </div>
  </section>

  <style>
    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding-inline: var(--pad);
    }
    .wrap--narrow {
      max-width: 900px;
    }

    .eyebrow {
      display: inline-block;
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 0.72rem;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .s-title {
      font-size: clamp(2.5rem, 7vw, 5rem);
      margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
      text-wrap: balance;
    }

    /* ---------- HERO ---------- */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--pad);
      padding-top: 6rem;
    }
    .hero-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      width: 100%;
    }
    .hero-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    }
    .tag {
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.72rem;
      padding: 0.4em 0.7em;
      border: 1px solid var(--line);
      color: var(--fg);
    }
    .tag--accent {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .hero-title {
      font-size: clamp(2.5rem, 8.2vw, 7.5rem);
      line-height: 0.9;
      letter-spacing: -0.04em;
      max-width: 15ch;
    }
    .word-mask {
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
      padding-right: 0.22em;
    }
    .word {
      display: inline-block;
      will-change: transform;
    }
    .hero-sub {
      margin-top: clamp(1.5rem, 4vw, 2.5rem);
      max-width: 44ch;
      font-size: clamp(1rem, 1.6vw, 1.25rem);
      font-weight: var(--w-med);
      color: var(--muted);
    }
    .hero-scroll {
      position: absolute;
      bottom: 1.6rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 0.6rem;
      color: var(--muted);
    }
    .hero-scroll-line {
      width: 1px;
      height: 42px;
      background: linear-gradient(var(--accent), transparent);
    }

    /* ---------- STATEMENT ---------- */
    .statement {
      padding: clamp(6rem, 18vh, 14rem) var(--pad);
      max-width: 1100px;
      margin: 0 auto;
    }
    .statement-text {
      font-family: var(--font-display);
      font-weight: var(--w-black);
      text-transform: uppercase;
      font-size: clamp(2rem, 6vw, 4.5rem);
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .s-word {
      display: inline-block;
      margin-right: 0.25em;
      color: rgba(244, 244, 240, 0.16);
      transition: none;
    }

    /* ---------- TRABAJOS ---------- */
    .s-trabajos {
      position: relative;
    }
    .trabajos-pin {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(2rem, 5vw, 3.5rem);
      padding-block: clamp(4rem, 10vh, 7rem);
    }
    .trabajos-head {
      max-width: var(--maxw);
      margin: 0 auto;
      width: 100%;
      padding-inline: var(--pad);
    }
    .trabajos-title {
      font-size: clamp(2.5rem, 8vw, 6rem);
    }
    .trabajos-viewport {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .trabajos-viewport::-webkit-scrollbar {
      display: none;
    }
    .trabajos-track {
      display: flex;
      gap: clamp(1rem, 2vw, 1.75rem);
      padding-inline: var(--pad);
      width: max-content;
    }
    .vcard {
      width: min(74vw, 320px);
      flex: 0 0 auto;
    }
    .vmedia {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      background: #101013;
      border: 1px solid var(--line);
      cursor: pointer;
      padding: 0;
      color: inherit;
      text-decoration: none;
    }
    .vmedia img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .vmedia:hover img {
      transform: scale(1.05);
    }
    .vmedia--soon {
      flex-direction: column;
      gap: 1rem;
      cursor: default;
      background:
        repeating-linear-gradient(
          45deg,
          #0e0e11 0 12px,
          #131317 12px 24px
        );
    }
    .vplay {
      position: absolute;
      bottom: 0.9rem;
      right: 0.9rem;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent);
      color: #fff;
      border-radius: 50%;
      transition: transform 0.3s ease;
    }
    .vmedia:hover .vplay {
      transform: scale(1.1);
    }
    .vplay svg {
      width: 18px;
      height: 18px;
      margin-left: 2px;
    }
    .vplay--ghost {
      position: static;
      background: transparent;
      border: 2px solid var(--accent);
      color: var(--accent);
    }
    .vsoon {
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.72rem;
      color: var(--muted);
    }
    :global(.vmedia-iframe) {
      width: 100%;
      aspect-ratio: 9 / 16;
      border: 1px solid var(--line);
      display: block;
      background: #000;
    }
    .vinfo {
      padding-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .vcat {
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.68rem;
      color: var(--accent);
    }
    .vtitle {
      font-size: 1.05rem;
      text-transform: none;
      letter-spacing: -0.01em;
      line-height: 1.1;
    }

    /* ---------- SERVICIOS ---------- */
    .s-servicios {
      padding-block: clamp(6rem, 14vh, 11rem);
    }
    .servicios-grid {
      display: grid;
      gap: 1.25rem;
    }
    .scard {
      border: 1px solid var(--line);
      padding: clamp(1.5rem, 3vw, 2.5rem);
      display: flex;
      flex-direction: column;
      background: rgba(255, 255, 255, 0.015);
      transition: border-color 0.3s ease, background 0.3s ease;
    }
    .scard:hover {
      border-color: rgba(244, 244, 240, 0.35);
      background: rgba(255, 255, 255, 0.03);
    }
    .scard-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .scard-top h3 {
      font-size: clamp(1.4rem, 2.5vw, 2rem);
    }
    .scard-precio {
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 0.68rem;
      color: var(--accent);
      white-space: nowrap;
    }
    .scard-desc {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
      max-width: 46ch;
    }
    .scard-list {
      list-style: none;
      margin-bottom: 2rem;
      display: grid;
      gap: 0.6rem;
    }
    .scard-list li {
      position: relative;
      padding-left: 1.4rem;
      font-size: 0.92rem;
      color: var(--fg);
    }
    .scard-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 8px;
      height: 8px;
      background: var(--accent);
    }
    .scard-cta {
      margin-top: auto;
      align-self: flex-start;
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 0.78rem;
      text-decoration: none;
      color: var(--fg);
      padding: 0.8em 1.4em;
      border: 1px solid var(--fg);
      transition: background 0.25s ease, color 0.25s ease;
    }
    .scard-cta:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    /* ---------- PROCESO ---------- */
    .s-proceso {
      padding-block: clamp(6rem, 14vh, 11rem);
    }
    .proceso {
      list-style: none;
      display: grid;
      gap: 0;
    }
    .paso {
      display: flex;
      gap: clamp(1.5rem, 4vw, 4rem);
      align-items: baseline;
      padding-block: clamp(1.5rem, 3vw, 2.25rem);
      border-top: 1px solid var(--line);
    }
    .paso:last-child {
      border-bottom: 1px solid var(--line);
    }
    .paso-num {
      font-family: var(--font-display);
      font-weight: var(--w-black);
      font-size: clamp(1.5rem, 4vw, 3rem);
      color: var(--accent);
      line-height: 1;
      flex: 0 0 auto;
    }
    .paso-body h3 {
      font-size: clamp(1.3rem, 3vw, 2.25rem);
      margin-bottom: 0.6rem;
    }
    .paso-body p {
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.55;
      max-width: 60ch;
    }

    /* ---------- SOBRE MÍ ---------- */
    .s-sobre {
      padding-block: clamp(6rem, 14vh, 11rem);
    }
    .sobre-text p {
      font-size: clamp(1.3rem, 3vw, 2.1rem);
      font-weight: var(--w-med);
      line-height: 1.35;
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
    }
    .sobre-text p:last-child {
      margin-bottom: 0;
      color: var(--muted);
      font-size: clamp(1.05rem, 2vw, 1.4rem);
      border-left: 2px solid var(--accent);
      padding-left: 1.25rem;
    }

    /* ---------- CONTACTO ---------- */
    .s-contacto {
      padding-block: clamp(6rem, 16vh, 13rem);
    }
    .contacto-big {
      font-size: clamp(2rem, 5.5vw, 4.5rem);
      max-width: 20ch;
      margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
      text-wrap: balance;
    }
    .contacto-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2.5rem;
      border-top: 1px solid var(--line);
      padding-top: 2.5rem;
    }
    .contacto-mail {
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      font-size: clamp(1.1rem, 3vw, 2rem);
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--fg);
      border-bottom: 2px solid var(--accent);
      transition: color 0.25s ease;
    }
    .contacto-mail:hover {
      color: var(--accent);
    }
    .contacto-redes {
      list-style: none;
      display: grid;
      gap: 0.75rem;
    }
    .contacto-redes li {
      display: flex;
      gap: 1rem;
      align-items: baseline;
    }
    .contacto-redes span {
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.62rem;
      color: var(--muted);
      min-width: 8ch;
    }
    .contacto-redes a {
      font-weight: var(--w-bold);
      text-decoration: none;
      color: var(--fg);
    }
    .contacto-redes a:hover {
      color: var(--accent);
    }

    @media (min-width: 720px) {
      .servicios-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Escritorio: scroll horizontal controlado por GSAP (pin) */
    @media (min-width: 768px) {
      .trabajos-viewport {
        overflow: visible;
      }
      .vcard {
        width: 340px;
      }
    }

    /* Sin animación: todo visible y sin trucos de scroll */
    :global(body.no-anim) .trabajos-viewport {
      overflow-x: auto !important;
    }
    :global(body.no-anim) .s-word {
      color: var(--fg) !important;
    }
  </style>

  <Fragment slot="scripts">
    <script>
      import * as THREE from "three";
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ============================================================
         1. Fondo WebGL (shader de ruido rojo/oscuro reactivo al scroll)
         ============================================================ */
      function initBackground() {
        const canvas = document.getElementById("bg-canvas") as HTMLCanvasElement | null;
        if (!canvas) return;

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: false });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

        const scene = new THREE.Scene();
        const camera = new THREE.Camera();

        const uniforms = {
          uTime: { value: 0 },
          uScroll: { value: 0 },
          uRes: { value: new THREE.Vector2(1, 1) },
        };

        const material = new THREE.ShaderMaterial({
          uniforms,
          vertexShader: `
            void main() { gl_Position = vec4(position, 1.0); }
          `,
          fragmentShader: `
            precision highp float;
            uniform float uTime;
            uniform float uScroll;
            uniform vec2 uRes;

            vec2 hash(vec2 p){ p = vec2(dot(p, vec2(127.1,311.7)), dot(p, vec2(269.5,183.3))); return -1.0 + 2.0*fract(sin(p)*43758.5453123); }
            float noise(vec2 p){
              const float K1 = 0.366025404; const float K2 = 0.211324865;
              vec2 i = floor(p + (p.x + p.y)*K1);
              vec2 a = p - i + (i.x + i.y)*K2;
              float m = step(a.y, a.x);
              vec2 o = vec2(m, 1.0 - m);
              vec2 b = a - o + K2;
              vec2 c = a - 1.0 + 2.0*K2;
              vec3 h = max(0.5 - vec3(dot(a,a), dot(b,b), dot(c,c)), 0.0);
              vec3 n = h*h*h*h*vec3(dot(a, hash(i+0.0)), dot(b, hash(i+o)), dot(c, hash(i+1.0)));
              return dot(n, vec3(70.0));
            }
            float fbm(vec2 p){ float v = 0.0; float a = 0.5; for(int i=0;i<5;i++){ v += a*noise(p); p *= 2.0; a *= 0.5; } return v; }

            void main(){
              vec2 uv = gl_FragCoord.xy / uRes.xy;
              vec2 p = (uv - 0.5) * vec2(uRes.x/uRes.y, 1.0) * 3.0;
              float t = uTime * 0.04 + uScroll * 2.0;
              float n = fbm(p + vec2(t, t*0.6) + fbm(p*0.6 - t*0.5));
              vec3 base = vec3(0.05, 0.02, 0.03);
              vec3 red  = vec3(1.0, 0.15, 0.08);
              float glow = smoothstep(-0.25, 0.9, n);
              vec3 col = mix(base, red*0.7, glow*0.85);
              // núcleos brillantes en las crestas del ruido
              col += red * smoothstep(0.5, 0.95, n) * 0.5;
              float vig = smoothstep(1.5, 0.15, length(uv - 0.5));
              col *= vig;
              col += red * 0.12 * uScroll;
              gl_FragColor = vec4(col, 1.0);
            }
          `,
        });

        const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);
        scene.add(quad);

        function resize() {
          const w = window.innerWidth;
          const h = window.innerHeight;
          renderer.setSize(w, h, false);
          uniforms.uRes.value.set(w * renderer.getPixelRatio(), h * renderer.getPixelRatio());
        }
        resize();
        window.addEventListener("resize", resize);

        let raf = 0;
        const start = performance.now();
        function render() {
          uniforms.uTime.value = (performance.now() - start) / 1000;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          uniforms.uScroll.value = max > 0 ? window.scrollY / max : 0;
          renderer.render(scene, camera);
          raf = requestAnimationFrame(render);
        }
        render();

        if (reduced) {
          // Un solo frame estático
          cancelAnimationFrame(raf);
          renderer.render(scene, camera);
        }
      }

      /* ============================================================
         2. Smooth scroll (Lenis) + sync con ScrollTrigger
         ============================================================ */
      function initSmoothScroll() {
        if (reduced) return null;
        const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
        return lenis;
      }

      /* ============================================================
         3. Animaciones de scroll (GSAP)
         ============================================================ */
      function initAnimations() {
        // Progreso
        const bar = document.getElementById("scroll-progress-bar");
        if (bar) {
          gsap.to(bar, {
            scaleX: 1,
            ease: "none",
            scrollTrigger: { start: 0, end: "max", scrub: 0.3 },
          });
        }

        if (reduced) return;

        // Hero: palabras suben desde su máscara
        gsap.set(".hero-title .word", { yPercent: 120 });
        const tl = gsap.timeline({ delay: 0.15 });
        tl.to(".hero-title .word", {
          yPercent: 0,
          duration: 1.1,
          ease: "power4.out",
          stagger: 0.06,
        });
        tl.from("[data-hero]", { y: 24, opacity: 0, duration: 0.8, stagger: 0.12, ease: "power3.out" }, "-=0.7");

        // Statement: palabras se "encienden" a blanco al pasar
        const sWords = gsap.utils.toArray<HTMLElement>("[data-statement]");
        if (sWords.length) {
          gsap.to(sWords, {
            color: "rgba(244,244,240,1)",
            stagger: 0.08,
            ease: "none",
            scrollTrigger: {
              trigger: ".statement",
              start: "top 75%",
              end: "bottom 60%",
              scrub: true,
            },
          });
        }

        // Reveals genéricos
        gsap.set("[data-reveal]", { y: 42, opacity: 0 });
        ScrollTrigger.batch("[data-reveal]", {
          start: "top 88%",
          onEnter: (els) =>
            gsap.to(els, {
              y: 0,
              opacity: 1,
              duration: 0.9,
              ease: "power3.out",
              stagger: 0.09,
              overwrite: true,
            }),
        });

        // Trabajos: scroll horizontal con pin (solo escritorio)
        const mm = gsap.matchMedia();
        mm.add("(min-width: 768px)", () => {
          const track = document.getElementById("trabajos-track");
          const section = document.querySelector<HTMLElement>(".s-trabajos");
          if (!track || !section) return;

          const distance = () => Math.max(0, track.scrollWidth - window.innerWidth + 80);

          // Solo pinneamos si hay recorrido horizontal real (evita un pin
          // "pegajoso" cuando hay pocas tarjetas).
          if (distance() < 120) return;

          gsap.to(track, {
            x: () => -distance(),
            ease: "none",
            scrollTrigger: {
              trigger: section,
              start: "top top",
              end: () => "+=" + distance(),
              pin: true,
              scrub: 1,
              invalidateOnRefresh: true,
              anticipatePin: 1,
            },
          });
        });
      }

      /* ============================================================
         4. Facade de video: al hacer clic, carga el iframe
         ============================================================ */
      function initVideoFacade() {
        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          const media = target.closest<HTMLElement>(".vmedia[data-embed]");
          if (!media) return;
          const src = media.getAttribute("data-embed");
          if (!src) return;
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.className = "vmedia-iframe";
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "");
          iframe.setAttribute("title", media.getAttribute("aria-label") ?? "Video");
          media.replaceWith(iframe);
          ScrollTrigger.refresh();
        });
      }

      /* ============================================================
         5. Anchors con smooth scroll
         ============================================================ */
      function initAnchors(lenis: Lenis | null) {
        document.querySelectorAll<HTMLAnchorElement>("a[data-scroll]").forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href");
            if (!id || !id.startsWith("#")) return;
            const el = document.querySelector(id);
            if (!el) return;
            e.preventDefault();
            if (lenis) lenis.scrollTo(el as HTMLElement, { offset: 0 });
            else (el as HTMLElement).scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
          });
        });
      }

      /* ---------- Arranque ---------- */
      if (reduced) document.body.classList.add("no-anim");
      initBackground();
      const lenis = initSmoothScroll();
      initAnimations();
      initVideoFacade();
      initAnchors(lenis);
      // Recalcular medidas cuando todo cargó (fuentes, imágenes)
      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
  </Fragment>
</Immersive>
