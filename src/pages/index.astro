---
import Immersive from "../layouts/Immersive.astro";
import { PERFIL, VIDEOS, PROCESO, CONTACTO } from "../data/portfolio";

/* Datos de reproducción de cada video (nada se aloja aquí; se incrusta) */
function youtubeThumb(id: string) {
  return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
}
const videos = VIDEOS.map((v) => {
  const esReal = Boolean(v.fuente && v.videoId);
  let thumb = v.thumbnail ?? "";
  let embed = "";
  let enlace = "";
  if (esReal) {
    const id = v.videoId as string;
    if (v.fuente === "youtube") {
      thumb = v.thumbnail ?? youtubeThumb(id);
      embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      enlace = `https://youtu.be/${id}`;
    } else if (v.fuente === "vimeo") {
      embed = `https://player.vimeo.com/video/${id}?autoplay=1`;
      enlace = `https://vimeo.com/${id}`;
    } else {
      enlace = id;
    }
  }
  return { ...v, esReal, thumb, embed, enlace, puedeIncrustar: embed !== "" };
});

const tituloPalabras = PERFIL.titular.replace(/\.$/, "").split(" ");
---

<Immersive>
  <!-- ===================== HERO ===================== -->
  <section class="hero" id="top">
    <div class="hero-inner">
      <div class="hero-kicker" data-hero>
        <span class="tag">{PERFIL.rol}</span>
        <span class="tag tag--accent">{PERFIL.disponibilidad}</span>
      </div>

      <h1 class="hero-title">
        {
          tituloPalabras.map((w) => (
            <span class="word-mask">
              <span class="word">{w}</span>
            </span>
          ))
        }
      </h1>

      <p class="hero-sub" data-hero>{PERFIL.subtitular}</p>
    </div>

    <div class="hero-scroll" data-hero>
      <span>Scroll</span>
      <span class="hero-scroll-line"></span>
    </div>
  </section>

  <!-- ===================== STATEMENT ===================== -->
  <section class="statement">
    <p class="statement-text">
      {
        "No hago anuncios. Hago videos que la gente termina de ver."
          .split(" ")
          .map((w) => (
            <span class="s-word" data-statement>
              {w}{" "}
            </span>
          ))
      }
    </p>
  </section>

  <!-- ===================== TRABAJOS (scroll horizontal) ===================== -->
  <section class="s-trabajos" id="trabajos">
    <div class="trabajos-pin">
      <div class="trabajos-head">
        <span class="eyebrow" data-reveal data-speed="0.5">01 / Trabajos</span>
        <h2 class="trabajos-title" data-reveal data-speed="0.2">Videos UGC</h2>
      </div>

      <div class="trabajos-viewport">
        <div class="trabajos-track" id="trabajos-track">
          {
            videos.map((v) => (
              <article class="vcard">
                {v.esReal ? (
                  v.puedeIncrustar ? (
                    <button
                      type="button"
                      class="vmedia"
                      data-embed={v.embed}
                      aria-label={`Reproducir: ${v.titulo ?? "video"}`}
                    >
                      <img src={v.thumb} alt={`Miniatura de ${v.titulo ?? "video"}`} loading="lazy" />
                      <span class="vplay" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      </span>
                    </button>
                  ) : (
                    <a class="vmedia" href={v.enlace} target="_blank" rel="noopener" aria-label={`Ver: ${v.titulo ?? "video"}`}>
                      <img src={v.thumb} alt={`Miniatura de ${v.titulo ?? "video"}`} loading="lazy" />
                      <span class="vplay" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      </span>
                    </a>
                  )
                ) : (
                  <div class="vmedia vmedia--soon">
                    <span class="vplay vplay--ghost" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                    <span class="vsoon">Próximamente</span>
                  </div>
                )}
                <div class="vinfo">
                  {v.categoria && <span class="vcat">{v.categoria}</span>}
                  {v.titulo && <h3 class="vtitle">{v.titulo}</h3>}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESO ===================== -->
  <section class="s-proceso">
    <div class="wrap">
      <span class="eyebrow" data-reveal data-speed="0.5">02 / Proceso</span>
      <h2 class="s-title" data-reveal data-speed="0.2">De la idea a la entrega</h2>
      <ol class="proceso">
        {
          PROCESO.map((p, i) => (
            <li class="paso" data-reveal data-speed={String(0.12 + i * 0.06)}>
              <span class="paso-num">{String(i + 1).padStart(2, "0")}</span>
              <div class="paso-body">
                <h3>{p.titulo}</h3>
                <p>{p.descripcion}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== SOBRE MÍ ===================== -->
  <section class="s-sobre" id="sobre">
    <div class="wrap wrap--narrow">
      <span class="eyebrow" data-reveal data-speed="0.5">03 / Sobre mí</span>
      <div class="sobre-text">
        {PERFIL.sobre_mi.map((p) => <p data-reveal>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ===================== CONTACTO ===================== -->
  <section class="s-contacto" id="contacto">
    <div class="wrap">
      <span class="eyebrow" data-reveal data-speed="0.5">04 / Contacto</span>
      <h2 class="contacto-big" data-reveal data-speed="0.15">{CONTACTO.cierre}</h2>
      <div class="contacto-grid">
        <a class="contacto-mail" href={`mailto:${CONTACTO.email}`} data-reveal>{CONTACTO.email}</a>
        <ul class="contacto-redes" data-reveal>
          <li><span>Instagram</span><a href={CONTACTO.instagram.url} target="_blank" rel="noopener">{CONTACTO.instagram.usuario}</a></li>
          <li><span>TikTok</span><a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">{CONTACTO.tiktok.usuario}</a></li>
        </ul>
      </div>
    </div>
  </section>

  <style>
    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding-inline: var(--pad);
    }
    .wrap--narrow {
      max-width: 900px;
    }

    .eyebrow {
      display: inline-block;
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.12em;
      font-size: 0.72rem;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .s-title {
      font-size: clamp(2.5rem, 7vw, 5rem);
      margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
      text-wrap: balance;
    }

    /* ---------- HERO ---------- */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--pad);
      padding-top: 6rem;
    }
    .hero-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      width: 100%;
    }
    .hero-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    }
    .tag {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.03em;
      font-size: 0.72rem;
      padding: 0.45em 0.75em;
      border: 1px solid var(--line);
      color: var(--fg);
    }
    .tag--accent {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .hero-title {
      font-size: clamp(2.5rem, 8.2vw, 7.5rem);
      line-height: 0.9;
      letter-spacing: -0.04em;
      max-width: 15ch;
    }
    .word-mask {
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
      padding-right: 0.22em;
    }
    .word {
      display: inline-block;
      will-change: transform;
    }
    .hero-sub {
      margin-top: clamp(1.5rem, 4vw, 2.5rem);
      max-width: 44ch;
      font-size: clamp(1rem, 1.6vw, 1.25rem);
      font-weight: var(--w-med);
      color: var(--muted);
    }
    .hero-scroll {
      position: absolute;
      bottom: 1.6rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 0.6rem;
      color: var(--muted);
    }
    .hero-scroll-line {
      width: 1px;
      height: 42px;
      background: linear-gradient(var(--accent), transparent);
    }

    /* ---------- STATEMENT ---------- */
    .statement {
      padding: clamp(6rem, 18vh, 14rem) var(--pad);
      max-width: 1100px;
      margin: 0 auto;
    }
    .statement-text {
      font-family: var(--font-display);
      font-weight: var(--w-black);
      text-transform: uppercase;
      font-size: clamp(2rem, 6vw, 4.5rem);
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .s-word {
      display: inline-block;
      margin-right: 0.25em;
      color: rgba(22, 21, 27, 0.16);
      transition: none;
    }

    /* ---------- TRABAJOS ---------- */
    .s-trabajos {
      position: relative;
    }
    .trabajos-pin {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(2rem, 5vw, 3.5rem);
      padding-block: clamp(4rem, 10vh, 7rem);
    }
    .trabajos-head {
      max-width: var(--maxw);
      margin: 0 auto;
      width: 100%;
      padding-inline: var(--pad);
    }
    .trabajos-title {
      font-size: clamp(2.5rem, 8vw, 6rem);
    }
    .trabajos-viewport {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .trabajos-viewport::-webkit-scrollbar {
      display: none;
    }
    .trabajos-track {
      display: flex;
      gap: clamp(1rem, 2vw, 1.75rem);
      padding-inline: var(--pad);
      width: max-content;
    }
    .vcard {
      width: min(74vw, 320px);
      flex: 0 0 auto;
    }
    .vmedia {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      background: var(--bg-2);
      border: 1px solid var(--line);
      cursor: pointer;
      padding: 0;
      color: inherit;
      text-decoration: none;
      transition: border-color 0.3s ease;
    }
    .vmedia:hover {
      border-color: var(--fg);
    }
    .vmedia img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .vmedia:hover img {
      transform: scale(1.05);
    }
    .vmedia--soon {
      flex-direction: column;
      gap: 1rem;
      cursor: default;
      background:
        repeating-linear-gradient(
          45deg,
          #dcd8cf 0 12px,
          #d2cec4 12px 24px
        );
    }
    .vplay {
      position: absolute;
      bottom: 0.9rem;
      right: 0.9rem;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent);
      color: #fff;
      border-radius: 50%;
      transition: transform 0.3s ease;
    }
    .vmedia:hover .vplay {
      transform: scale(1.1);
    }
    .vplay svg {
      width: 18px;
      height: 18px;
      margin-left: 2px;
    }
    .vplay--ghost {
      position: static;
      background: transparent;
      border: 2px solid var(--accent);
      color: var(--accent);
    }
    .vsoon {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.08em;
      font-size: 0.72rem;
      color: var(--muted);
    }
    :global(.vmedia-iframe) {
      width: 100%;
      aspect-ratio: 9 / 16;
      border: 1px solid var(--line);
      display: block;
      background: #000;
    }
    .vinfo {
      padding-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .vcat {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.04em;
      font-size: 0.68rem;
      color: var(--accent);
    }
    .vtitle {
      font-size: 1.05rem;
      text-transform: none;
      letter-spacing: -0.01em;
      line-height: 1.1;
    }

    /* ---------- PROCESO ---------- */
    .s-proceso {
      padding-block: clamp(6rem, 14vh, 11rem);
    }
    .proceso {
      list-style: none;
      display: grid;
      gap: 0;
    }
    .paso {
      display: flex;
      gap: clamp(1.5rem, 4vw, 4rem);
      align-items: baseline;
      padding-block: clamp(1.5rem, 3vw, 2.25rem);
      border-top: 1px solid var(--line);
    }
    .paso:last-child {
      border-bottom: 1px solid var(--line);
    }
    .paso-num {
      font-family: var(--font-display);
      font-weight: var(--w-black);
      font-size: clamp(1.5rem, 4vw, 3rem);
      color: var(--accent);
      line-height: 1;
      flex: 0 0 auto;
    }
    .paso-body h3 {
      font-size: clamp(1.3rem, 3vw, 2.25rem);
      margin-bottom: 0.6rem;
    }
    .paso-body p {
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.55;
      max-width: 60ch;
    }

    /* ---------- SOBRE MÍ ---------- */
    .s-sobre {
      padding-block: clamp(6rem, 14vh, 11rem);
    }
    .sobre-text p {
      font-size: clamp(1.3rem, 3vw, 2.1rem);
      font-weight: var(--w-med);
      line-height: 1.35;
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
    }
    .sobre-text p:last-child {
      margin-bottom: 0;
      color: var(--muted);
      font-size: clamp(1.05rem, 2vw, 1.4rem);
      border-left: 2px solid var(--accent);
      padding-left: 1.25rem;
    }

    /* ---------- CONTACTO ---------- */
    .s-contacto {
      padding-block: clamp(6rem, 16vh, 13rem);
    }
    .contacto-big {
      font-size: clamp(2rem, 5.5vw, 4.5rem);
      max-width: 20ch;
      margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
      text-wrap: balance;
    }
    .contacto-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2.5rem;
      border-top: 1px solid var(--line);
      padding-top: 2.5rem;
    }
    .contacto-mail {
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      font-size: clamp(1.1rem, 3vw, 2rem);
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--fg);
      border-bottom: 2px solid var(--accent);
      transition: color 0.25s ease;
    }
    .contacto-mail:hover {
      color: var(--accent);
    }
    .contacto-redes {
      list-style: none;
      display: grid;
      gap: 0.75rem;
    }
    .contacto-redes li {
      display: flex;
      gap: 1rem;
      align-items: baseline;
    }
    .contacto-redes span {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.06em;
      font-size: 0.66rem;
      color: var(--muted);
      min-width: 8ch;
    }
    .contacto-redes a {
      font-weight: var(--w-bold);
      text-decoration: none;
      color: var(--fg);
    }
    .contacto-redes a:hover {
      color: var(--accent);
    }

    /* Escritorio: el carrusel se desliza con el scroll (GSAP scrub) */
    @media (min-width: 768px) {
      .trabajos-viewport {
        overflow: hidden;
      }
      .vcard {
        width: 340px;
      }
    }

    /* Sin animación: todo visible y sin trucos de scroll */
    :global(body.no-anim) .trabajos-viewport {
      overflow-x: auto !important;
    }
    :global(body.no-anim) .s-word {
      color: var(--fg) !important;
    }
  </style>

  <Fragment slot="scripts">
    <script>
      import { Renderer, Camera, Transform, Program, Mesh, Box, Sphere, Torus, Cylinder, Color, Vec3 } from "ogl";
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ============================================================
         1. Fondo 3D (OGL): figuras geométricas flotando que se mueven
            con el scroll. Ligero (~12 kB gzip) en vez de Three.js.
         ============================================================ */
      function initBackground() {
        const canvas = document.getElementById("bg-canvas") as HTMLCanvasElement | null;
        if (!canvas) return;

        const renderer = new Renderer({
          canvas,
          alpha: true,
          antialias: true,
          dpr: Math.min(window.devicePixelRatio, 1.5),
        });
        const gl = renderer.gl;
        gl.clearColor(0, 0, 0, 0);

        const camera = new Camera(gl, { fov: 35 });
        camera.position.set(0, 0, 9);

        const scene = new Transform();

        const vertex = `
          attribute vec3 position;
          attribute vec3 normal;
          uniform mat4 modelMatrix;
          uniform mat4 modelViewMatrix;
          uniform mat4 projectionMatrix;
          uniform mat3 normalMatrix;
          varying vec3 vNormal;
          varying vec3 vWorld;
          void main() {
            vNormal = normalize(normalMatrix * normal);
            vWorld = (modelMatrix * vec4(position, 1.0)).xyz;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `;
        const fragment = `
          precision highp float;
          uniform vec3 uColor;
          uniform vec3 uLight;
          uniform vec3 uCam;
          varying vec3 vNormal;
          varying vec3 vWorld;
          void main() {
            vec3 N = normalize(vNormal);
            vec3 L = normalize(uLight);
            float diff = clamp(dot(N, L), 0.0, 1.0);
            vec3 V = normalize(uCam - vWorld);
            float fres = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 2.2);
            vec3 col = uColor * (0.42 + 0.72 * diff);
            col += vec3(1.0) * fres * 0.18;
            // Niebla por profundidad: las figuras lejanas se funden con el papel
            float dist = length(uCam - vWorld);
            float fog = clamp(1.0 - exp(-0.055 * max(dist - 6.0, 0.0)), 0.0, 0.92);
            col = mix(col, vec3(0.906, 0.894, 0.867), fog);
            gl_FragColor = vec4(col, 1.0);
          }
        `;

        // Paleta techie/creativa para fondo claro: tonos medios que
        // contrastan tanto con el papel como con el texto oscuro.
        const palette = ["#2438d1", "#ff5a1f", "#38445a", "#a8a294", "#c4462a"];
        const light = new Vec3(2.5, 4.0, 3.0);

        type Shape = { mesh: Mesh; rot: Vec3; spin: number; baseY: number; depth: number };
        const shapes: Shape[] = [];

        function geom(kind: number) {
          if (kind === 0) return new Box(gl, { width: 1.4, height: 1.4, depth: 1.4 });
          if (kind === 1) return new Sphere(gl, { radius: 0.95, widthSegments: 2, heightSegments: 2 });
          if (kind === 2) return new Torus(gl, { radius: 0.85, tube: 0.32, radialSegments: 8, tubularSegments: 16 });
          if (kind === 3) return new Sphere(gl, { radius: 0.95, widthSegments: 32, heightSegments: 24 });
          return new Cylinder(gl, { radiusTop: 0.7, radiusBottom: 0.7, height: 1.6, radialSegments: 6 });
        }

        // Distribución en la periferia y en profundidad, para enmarcar el
        // contenido central sin taparlo.
        const layout = [
          { x: -6.6, y: 2.4, z: -4, s: 1.5, k: 0, c: 0 },
          { x: 6.8, y: 2.8, z: -3, s: 1.4, k: 2, c: 2 },
          { x: 6.4, y: -2.6, z: -5, s: 1.7, k: 4, c: 4 },
          { x: -7.0, y: -2.6, z: -6, s: 1.8, k: 3, c: 3 },
          { x: 8.0, y: 0.4, z: -9, s: 2.3, k: 1, c: 1 },
          { x: -8.2, y: -0.2, z: -10, s: 2.5, k: 2, c: 2 },
          { x: 3.6, y: 5.2, z: -12, s: 2.2, k: 0, c: 4 },
          { x: -3.2, y: -5.6, z: -13, s: 2.4, k: 4, c: 3 },
        ];

        for (const it of layout) {
          const program = new Program(gl, {
            vertex,
            fragment,
            uniforms: {
              uColor: { value: new Color(palette[it.c]) },
              uLight: { value: light },
              uCam: { value: camera.position },
            },
          });
          const mesh = new Mesh(gl, { geometry: geom(it.k), program });
          mesh.position.set(it.x, it.y, it.z);
          mesh.scale.set(it.s, it.s, it.s);
          mesh.setParent(scene);
          shapes.push({
            mesh,
            rot: new Vec3(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI),
            spin: 0.1 + Math.random() * 0.25,
            baseY: it.y,
            depth: it.z,
          });
        }

        function resize() {
          renderer.setSize(window.innerWidth, window.innerHeight);
          camera.perspective({ aspect: gl.canvas.width / gl.canvas.height });
        }
        resize();
        window.addEventListener("resize", resize);

        // Parallax con el mouse
        const mouse = { x: 0, y: 0 };
        const mTarget = { x: 0, y: 0 };
        if (!reduced) {
          window.addEventListener("pointermove", (e) => {
            mTarget.x = (e.clientX / window.innerWidth - 0.5) * 2;
            mTarget.y = (e.clientY / window.innerHeight - 0.5) * 2;
          });
        }

        let raf = 0;
        const start = performance.now();
        let scroll = 0;

        function frame() {
          const t = (performance.now() - start) / 1000;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const target = max > 0 ? window.scrollY / max : 0;
          scroll += (target - scroll) * 0.08;

          mouse.x += (mTarget.x - mouse.x) * 0.05;
          mouse.y += (mTarget.y - mouse.y) * 0.05;

          for (const s of shapes) {
            s.mesh.rotation.x = s.rot.x + t * s.spin;
            s.mesh.rotation.y = s.rot.y + t * s.spin * 0.8;
            // El scroll desplaza las figuras hacia arriba (drift)
            s.mesh.position.y = s.baseY + scroll * 6.0;
          }

          // El scroll gira y acerca la escena: sensación de volar entre las figuras
          scene.rotation.y = scroll * 1.2 + mouse.x * 0.15;
          scene.rotation.x = mouse.y * 0.1;
          camera.position.z = 9 - scroll * 4.0;
          camera.position.x = mouse.x * 0.6;

          renderer.render({ scene, camera });
          raf = requestAnimationFrame(frame);
        }

        if (reduced) {
          renderer.render({ scene, camera });
        } else {
          frame();
        }

        window.addEventListener("beforeunload", () => cancelAnimationFrame(raf));
      }

      /* ============================================================
         2. Smooth scroll (Lenis) + sync con ScrollTrigger
         ============================================================ */
      function initSmoothScroll() {
        if (reduced) return null;
        const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
        return lenis;
      }

      /* ============================================================
         3. Animaciones de scroll (GSAP)
         ============================================================ */
      function initAnimations() {
        // Progreso
        const bar = document.getElementById("scroll-progress-bar");
        if (bar) {
          gsap.to(bar, {
            scaleX: 1,
            ease: "none",
            scrollTrigger: { start: 0, end: "max", scrub: 0.3 },
          });
        }

        if (reduced) return;

        // Hero: palabras suben desde su máscara
        gsap.set(".hero-title .word", { yPercent: 120 });
        const tl = gsap.timeline({ delay: 0.15 });
        tl.to(".hero-title .word", {
          yPercent: 0,
          duration: 1.1,
          ease: "power4.out",
          stagger: 0.06,
        });
        tl.from("[data-hero]", { y: 24, opacity: 0, duration: 0.8, stagger: 0.12, ease: "power3.out" }, "-=0.7");

        // Statement: las palabras se "encienden" a tinta conforme pasan
        const sWords = gsap.utils.toArray<HTMLElement>("[data-statement]");
        if (sWords.length) {
          gsap.to(sWords, {
            color: "rgba(22,21,27,1)",
            stagger: 0.08,
            ease: "none",
            scrollTrigger: {
              trigger: ".statement",
              start: "top 75%",
              end: "bottom 60%",
              scrub: true,
            },
          });
        }

        // Reveals: solo fundido de opacidad (el movimiento lo da el parallax)
        gsap.set("[data-reveal]", { opacity: 0 });
        ScrollTrigger.batch("[data-reveal]", {
          start: "top 90%",
          onEnter: (els) =>
            gsap.to(els, {
              opacity: 1,
              duration: 0.9,
              ease: "power2.out",
              stagger: 0.08,
              overwrite: "auto",
            }),
        });

        // Parallax continuo: cada elemento con data-speed se desplaza en
        // vertical de forma sutil mientras se scrollea (no solo al aparecer).
        gsap.utils.toArray<HTMLElement>("[data-speed]").forEach((el) => {
          const speed = parseFloat(el.dataset.speed || "0");
          gsap.fromTo(
            el,
            { y: speed * 70 },
            {
              y: -speed * 70,
              ease: "none",
              scrollTrigger: {
                trigger: el,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
              },
            }
          );
        });

        // Hero: el contenido se aleja (parallax + fade) al empezar a bajar
        gsap.to(".hero-inner", {
          yPercent: -14,
          opacity: 0.12,
          ease: "none",
          scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true },
        });

        // Trabajos: el carrusel se DESLIZA en horizontal conforme bajas
        // (ligado al scroll, sin pin, para que se sienta continuo).
        const mm = gsap.matchMedia();
        mm.add("(min-width: 768px)", () => {
          const track = document.getElementById("trabajos-track");
          const viewport = document.querySelector<HTMLElement>(".trabajos-viewport");
          if (!track || !viewport) return;
          const overflow = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
          gsap.fromTo(
            track,
            { x: 0 },
            {
              x: () => -overflow(),
              ease: "none",
              scrollTrigger: {
                trigger: ".s-trabajos",
                start: "top bottom",
                end: "bottom top",
                scrub: 0.6,
                invalidateOnRefresh: true,
              },
            }
          );
        });
      }

      /* ============================================================
         4. Facade de video: al hacer clic, carga el iframe
         ============================================================ */
      function initVideoFacade() {
        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          const media = target.closest<HTMLElement>(".vmedia[data-embed]");
          if (!media) return;
          const src = media.getAttribute("data-embed");
          if (!src) return;
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.className = "vmedia-iframe";
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "");
          iframe.setAttribute("title", media.getAttribute("aria-label") ?? "Video");
          media.replaceWith(iframe);
          ScrollTrigger.refresh();
        });
      }

      /* ============================================================
         5. Anchors con smooth scroll
         ============================================================ */
      function initAnchors(lenis: Lenis | null) {
        document.querySelectorAll<HTMLAnchorElement>("a[data-scroll]").forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href");
            if (!id || !id.startsWith("#")) return;
            const el = document.querySelector(id);
            if (!el) return;
            e.preventDefault();
            if (lenis) lenis.scrollTo(el as HTMLElement, { offset: 0 });
            else (el as HTMLElement).scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
          });
        });
      }

      /* ---------- Arranque ---------- */
      if (reduced) document.body.classList.add("no-anim");
      initBackground();
      const lenis = initSmoothScroll();
      initAnimations();
      initVideoFacade();
      initAnchors(lenis);
      // Recalcular medidas cuando todo cargó (fuentes, imágenes)
      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
  </Fragment>
</Immersive>
