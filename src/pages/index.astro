---
import Layout from "../components/Layout.astro";
import VideoCard from "../components/VideoCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import {
  PERFIL,
  METRICAS,
  VIDEOS,
  MARCAS,
  SERVICIOS,
  PROCESO,
  TESTIMONIOS,
  CONTACTO,
} from "../data/portfolio";
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-encabezado">
      <div>
        <h1 class="hero-nombre">{PERFIL.nombre}</h1>
        <p class="hero-rol">{PERFIL.rol}</p>
      </div>
      <div class="hero-detalles">
        <p>{PERFIL.ubicacion}</p>
        <p class="hero-disponibilidad">{PERFIL.disponibilidad}</p>
      </div>
    </div>

    <div class="hero-titular">
      <h2>{PERFIL.titular}</h2>
      <p>{PERFIL.subtitular}</p>
    </div>

    <div class="hero-acciones">
      <a class="boton" href={`mailto:${CONTACTO.email}`}>Trabajemos juntos</a>
      <a class="boton boton--secundario" href="#trabajos">Ver trabajos</a>
    </div>

    <ul class="metricas">
      {
        METRICAS.map((metrica) => (
          <li class="metrica">
            <span class="metrica-valor">{metrica.valor}</span>
            <span class="metrica-etiqueta">{metrica.etiqueta}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Trabajos -->
  <section id="trabajos" class="seccion">
    <h2 class="seccion-titulo">Trabajos</h2>
    <div class="videos-grid">
      {VIDEOS.map((video) => <VideoCard video={video} />)}
    </div>
  </section>

  <!-- Marcas -->
  <section class="seccion">
    <h2 class="seccion-titulo">Marcas</h2>
    <ul class="marcas">
      {
        MARCAS.map((marca) => (
          <li class="marca">
            <span class="marca-nombre">{marca.nombre}</span>
            <span class="marca-categoria">{marca.categoria}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Servicios -->
  <section id="servicios" class="seccion">
    <h2 class="seccion-titulo">Servicios</h2>
    <div class="servicios">
      {SERVICIOS.map((servicio) => <ServiceCard servicio={servicio} />)}
    </div>
  </section>

  <!-- Proceso -->
  <section class="seccion">
    <h2 class="seccion-titulo">Cómo trabajo</h2>
    <ol class="proceso">
      {
        PROCESO.map((paso, indice) => (
          <li class="paso">
            <span class="paso-numero">{String(indice + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="paso-titulo">{paso.titulo}</h3>
              <p class="paso-descripcion">{paso.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Sobre mí -->
  <section class="seccion">
    <h2 class="seccion-titulo">Sobre mí</h2>
    <p class="sobre-mi">{PERFIL.sobre_mi}</p>
  </section>

  <!-- Testimonios -->
  <section class="seccion">
    <h2 class="seccion-titulo">Lo que dicen</h2>
    <div class="testimonios">
      {
        TESTIMONIOS.map((testimonio) => (
          <blockquote class="testimonio">
            <p class="testimonio-texto">{testimonio.texto}</p>
            <footer class="testimonio-autor">
              {testimonio.autor} <span>· {testimonio.cargo}</span>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="seccion">
    <h2 class="seccion-titulo">Contacto</h2>
    <p class="contacto-cierre">{CONTACTO.cierre}</p>
    <ul class="contacto-lista">
      <li>
        <span class="contacto-etiqueta">Email</span>
        <a href={`mailto:${CONTACTO.email}`}>{CONTACTO.email}</a>
      </li>
      <li>
        <span class="contacto-etiqueta">Instagram</span>
        <a href={CONTACTO.instagram.url} target="_blank" rel="noopener">
          {CONTACTO.instagram.usuario}
        </a>
      </li>
      <li>
        <span class="contacto-etiqueta">TikTok</span>
        <a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">
          {CONTACTO.tiktok.usuario}
        </a>
      </li>
      {
        CONTACTO.whatsapp && (
          <li>
            <span class="contacto-etiqueta">WhatsApp</span>
            <a
              href={`https://wa.me/${CONTACTO.whatsapp.replace(/\D/g, "")}`}
              target="_blank"
              rel="noopener"
            >
              {CONTACTO.whatsapp}
            </a>
          </li>
        )
      }
    </ul>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    margin-bottom: var(--space-12);
  }

  .hero-encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  .hero-nombre {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-1);
  }

  .hero-rol {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .hero-detalles p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .hero-disponibilidad {
    color: var(--color-primary) !important;
  }

  .hero-titular h2 {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    text-wrap: balance;
    margin-bottom: var(--space-3);
  }

  .hero-titular p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .boton {
    display: inline-block;
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    text-decoration: none;
    letter-spacing: var(--letter-spacing-wide);
    border: 1px solid var(--color-primary);
    background-color: var(--color-primary);
    color: #fff;
    transition: all var(--transition-elegant);
  }

  .boton:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .boton--secundario {
    background-color: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border-light);
  }

  .boton--secundario:hover {
    background-color: transparent;
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Métricas */
  .metricas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }

  .metrica {
    display: flex;
    flex-direction: column;
  }

  .metrica-valor {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
  }

  .metrica-etiqueta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--letter-spacing-wide);
  }

  /* Secciones */
  .seccion {
    margin-bottom: var(--space-12);
    scroll-margin-top: var(--space-8);
  }

  .seccion-titulo {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  /* Trabajos */
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
  }

  /* Marcas */
  .marcas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .marca {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .marca-nombre {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
  }

  .marca-categoria {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Servicios */
  .servicios {
    display: grid;
    gap: var(--space-8);
  }

  /* Proceso */
  .proceso {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }

  .paso {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .paso-numero {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-primary);
    letter-spacing: var(--letter-spacing-wider);
    padding-top: 2px;
    min-width: 2ch;
  }

  .paso-titulo {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-1);
  }

  .paso-descripcion {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  /* Sobre mí */
  .sobre-mi {
    font-size: var(--text-base);
    color: var(--color-text-body);
    max-width: 65ch;
  }

  /* Testimonios */
  .testimonios {
    display: grid;
    gap: var(--space-6);
  }

  .testimonio {
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-4);
  }

  .testimonio-texto {
    font-size: var(--text-base);
    font-style: italic;
    color: var(--color-text-body);
    margin-bottom: var(--space-2);
  }

  .testimonio-autor {
    font-size: var(--text-xs);
    color: var(--color-text-primary);
    font-weight: var(--font-medium);
  }

  .testimonio-autor span {
    color: var(--color-text-muted);
    font-weight: var(--font-normal);
  }

  /* Contacto */
  .contacto-cierre {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    max-width: 55ch;
  }

  .contacto-lista {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .contacto-lista li {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .contacto-etiqueta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    min-width: 9ch;
  }

  .contacto-lista a {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-light);
    transition: color var(--transition-elegant);
  }

  .contacto-lista a:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Responsive */
  @media (min-width: 481px) {
    .hero-encabezado {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .hero-detalles {
      text-align: right;
    }

    .hero-nombre {
      font-size: var(--text-xl);
    }

    .hero-titular h2 {
      font-size: var(--text-3xl);
    }

    .metricas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .marcas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 769px) {
    .videos-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
