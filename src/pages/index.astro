---
import Immersive from "../layouts/Immersive.astro";
import { PERFIL, VIDEOS, PROCESO, CONTACTO } from "../data/portfolio";

/* Datos de reproducción de cada video (nada se aloja aquí; se incrusta) */
function youtubeThumb(id: string) {
  return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
}
const videos = VIDEOS.map((v) => {
  const esReal = Boolean(v.fuente && v.videoId);
  let thumb = v.thumbnail ?? "";
  let embed = "";
  let enlace = "";
  if (esReal) {
    const id = v.videoId as string;
    if (v.fuente === "youtube") {
      thumb = v.thumbnail ?? youtubeThumb(id);
      embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      enlace = `https://youtu.be/${id}`;
    } else if (v.fuente === "vimeo") {
      embed = `https://player.vimeo.com/video/${id}?autoplay=1`;
      enlace = `https://vimeo.com/${id}`;
    } else {
      enlace = id;
    }
  }
  return { ...v, esReal, thumb, embed, enlace, puedeIncrustar: embed !== "" };
});

const tituloPalabras = PERFIL.titular.replace(/\.$/, "").split(" ");
const STATEMENT = "No hago anuncios. Hago videos que la gente termina de ver.";
const TICKER = [
  "Video UGC",
  "Reels",
  "TikTok",
  "YouTube Shorts",
  "Guion y hooks",
  "Grabación",
  "Edición",
];
---

<Immersive>
  <!-- ===================== HERO ===================== -->
  <section class="hero" id="top">
    <div class="hero-inner">
      <div class="hero-kicker" data-hero>
        <span class="tag">{PERFIL.rol}</span>
        <span class="tag tag--accent">{PERFIL.disponibilidad}</span>
      </div>

      <h1 class="hero-title">
        {
          tituloPalabras.map((w) => (
            <span class="word-mask">
              <span class="word">{w}</span>
            </span>
          ))
        }
      </h1>

      <div class="hero-foot">
        <p class="hero-sub" data-hero>{PERFIL.subtitular}</p>
        <a class="hero-cta" href="#contacto" data-scroll data-hero>
          <span>Trabajemos juntos</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-scroll" data-hero>
      <span>Scroll</span>
      <span class="hero-scroll-line"></span>
    </div>
  </section>

  <!-- ===================== TICKER ===================== -->
  <section class="ticker" aria-hidden="true">
    <div class="ticker-track" id="ticker-track">
      {
        [0, 1].map(() => (
          <div class="ticker-group">
            {TICKER.map((t) => (
              <span class="ticker-item">
                {t}
                <i class="ticker-dot" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== STATEMENT ===================== -->
  <section class="statement">
    <div class="wrap">
      <p class="statement-text">
        {
          STATEMENT.split(" ").map((w) => (
            <span class="s-word" data-statement>
              {w}{" "}
            </span>
          ))
        }
      </p>
    </div>
  </section>

  <!-- ===================== TRABAJOS ===================== -->
  <section class="s-trabajos" id="trabajos">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow" data-reveal>01 / Trabajos</span>
        <h2 class="s-title" data-reveal data-speed="0.16">Videos UGC</h2>
      </div>
    </div>

    <div class="trabajos-viewport">
      <div class="trabajos-track" id="trabajos-track">
        {
          videos.map((v, i) => (
            <article class="vcard" data-card data-speed={String(i % 2 === 0 ? 0.1 : 0.22)}>
              {v.esReal ? (
                v.puedeIncrustar ? (
                  <button
                    type="button"
                    class="vmedia"
                    data-embed={v.embed}
                    aria-label={`Reproducir: ${v.titulo ?? "video"}`}
                  >
                    <img src={v.thumb} alt={`Miniatura de ${v.titulo ?? "video"}`} loading="lazy" />
                    <span class="vplay" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  </button>
                ) : (
                  <a
                    class="vmedia"
                    href={v.enlace}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Ver en ${v.fuente === "tiktok" ? "TikTok" : "Instagram"}: ${v.titulo ?? "video"}`}
                  >
                    <img src={v.thumb} alt={`Portada de ${v.titulo ?? "video"}`} loading="lazy" />
                    <span class={v.fuente === "instagram" ? "vplay vplay--ig" : "vplay"} aria-hidden="true">
                      {v.fuente === "instagram" ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="3" y="3" width="18" height="18" rx="5" />
                          <circle cx="12" cy="12" r="4" />
                          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      )}
                    </span>
                  </a>
                )
              ) : (
                <div class="vmedia vmedia--soon">
                  <span class="vplay vplay--ghost" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                  <span class="vsoon">Próximamente</span>
                </div>
              )}
              <div class="vinfo">
                <span class="vindex">{String(i + 1).padStart(2, "0")}</span>
                {v.categoria && <span class="vcat">{v.categoria}</span>}
                {v.titulo && <h3 class="vtitle">{v.titulo}</h3>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== PROCESO ===================== -->
  <section class="s-proceso">
    <div class="wrap proceso-grid">
      <div class="proceso-aside">
        <div class="proceso-sticky">
          <span class="eyebrow" data-reveal>02 / Proceso</span>
          <h2 class="s-title" data-reveal>De la idea a la entrega</h2>
          <div class="proceso-counter" aria-hidden="true">
            <span id="proceso-num">01</span>
            <span class="proceso-total">/ {String(PROCESO.length).padStart(2, "0")}</span>
          </div>
        </div>
      </div>

      <ol class="proceso">
        {
          PROCESO.map((p, i) => (
            <li class="paso" data-paso={String(i + 1).padStart(2, "0")}>
              <span class="paso-rule" aria-hidden="true" />
              <div class="paso-body">
                <span class="paso-num">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="line"><span class="line-inner">{p.titulo}</span></h3>
                <p class="line"><span class="line-inner">{p.descripcion}</span></p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== SOBRE MÍ ===================== -->
  <section class="s-sobre" id="sobre">
    <div class="wrap wrap--narrow">
      <span class="eyebrow" data-reveal>03 / Sobre mí</span>
      <div class="sobre-text">
        {
          PERFIL.sobre_mi.map((p) => (
            <p class="line">
              <span class="line-inner">{p}</span>
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== CONTACTO ===================== -->
  <section class="s-contacto" id="contacto">
    <div class="wrap">
      <span class="eyebrow" data-reveal>04 / Contacto</span>
      <h2 class="contacto-big">
        {
          CONTACTO.cierre.split(" ").map((w) => (
            <span class="word-mask">
              <span class="word word--c">{w}</span>
            </span>
          ))
        }
      </h2>

      <div class="contacto-grid" data-reveal>
        <a class="contacto-mail" href={`mailto:${CONTACTO.email}`}>
          <span>{CONTACTO.email}</span>
          <i class="sweep" aria-hidden="true"></i>
        </a>
        <ul class="contacto-redes">
          <li><span>Instagram</span><a href={CONTACTO.instagram.url} target="_blank" rel="noopener">{CONTACTO.instagram.usuario}</a></li>
          <li><span>TikTok</span><a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">{CONTACTO.tiktok.usuario}</a></li>
        </ul>
      </div>
    </div>
  </section>

  <style>
    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding-inline: var(--pad);
    }
    .wrap--narrow {
      max-width: 820px;
    }

    /* Ritmo de encabezado idéntico en todas las secciones:
       eyebrow -> (gap-eyebrow) -> título -> (gap-head) -> contenido */
    .eyebrow {
      display: block;
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.12em;
      font-size: 0.72rem;
      color: var(--accent);
      margin-bottom: var(--gap-eyebrow);
    }

    .s-title {
      font-size: clamp(2.25rem, 6vw, 4.5rem);
      text-wrap: balance;
      margin-bottom: var(--gap-head);
    }
    /* El .head solo agrupa; los márgenes los ponen sus hijos */
    .head > :last-child {
      margin-bottom: 0;
    }
    .head {
      margin-bottom: var(--gap-head);
    }

    /* Máscaras de palabra (hero y contacto) */
    .word-mask {
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
      padding-right: 0.22em;
      /* Igual que .line: deja aire para las tildes sin alterar el layout */
      padding-top: 0.14em;
      margin-top: -0.14em;
    }
    .word {
      display: inline-block;
      will-change: transform;
    }

    /* Líneas con máscara (proceso y sobre mí).
       El padding evita que la máscara recorte tildes y mayúsculas
       acentuadas (p. ej. GRABACIÓN); el margen negativo lo compensa. */
    .line {
      overflow: hidden;
      padding-top: 0.18em;
      margin-top: -0.18em;
    }
    .line-inner {
      display: block;
      will-change: transform;
    }

    /* ---------- HERO ---------- */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--pad);
      padding-top: calc(var(--nav-h) + var(--sp-l));
    }
    .hero-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      width: 100%;
    }
    .hero-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2xs) var(--sp-xs);
      margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
    }
    .tag {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.03em;
      font-size: 0.72rem;
      padding: 0.45em 0.75em;
      border: 1px solid var(--line);
      color: var(--muted);
    }
    .tag--accent {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .hero-title {
      font-size: clamp(2.5rem, 8vw, 7rem);
      line-height: 0.92;
      letter-spacing: -0.04em;
      max-width: 15ch;
    }
    .hero-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--sp-l);
      margin-top: clamp(1.75rem, 4vw, 2.75rem);
    }
    .hero-sub {
      max-width: 46ch;
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.5;
      font-weight: var(--w-med);
      color: var(--muted);
    }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-xs);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.03em;
      text-decoration: none;
      color: #fff;
      background: var(--fg);
      padding: 1em 1.5em;
      transition: background 0.3s ease;
      white-space: nowrap;
    }
    .hero-cta svg {
      width: 16px;
      height: 16px;
      transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .hero-cta:hover {
      background: var(--accent);
    }
    .hero-cta:hover svg {
      transform: translateX(5px);
    }
    .hero-scroll {
      position: absolute;
      bottom: 1.4rem;
      left: var(--pad);
      display: flex;
      align-items: center;
      gap: var(--sp-xs);
      font-family: var(--font-mono);
      letter-spacing: 0.18em;
      font-size: 0.6rem;
      color: var(--muted);
    }
    .hero-scroll-line {
      width: 54px;
      height: 1px;
      background: var(--muted);
      transform-origin: 0 50%;
    }

    /* ---------- TICKER ---------- */
    .ticker {
      border-block: 1px solid var(--line);
      padding-block: var(--sp-m);
      overflow: hidden;
    }
    .ticker-track {
      display: flex;
      width: max-content;
      will-change: transform;
    }
    .ticker-group {
      display: flex;
      align-items: center;
    }
    .ticker-item {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-m);
      padding-right: var(--sp-m);
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      font-size: clamp(1.1rem, 2.2vw, 1.7rem);
      color: var(--fg);
      white-space: nowrap;
    }
    .ticker-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      flex: 0 0 auto;
    }

    /* ---------- STATEMENT ---------- */
    .statement {
      padding-block: var(--section-y);
    }
    .statement-text {
      font-family: var(--font-display);
      font-weight: var(--w-black);
      text-transform: uppercase;
      font-size: clamp(1.75rem, 5vw, 4rem);
      line-height: 1.04;
      letter-spacing: -0.03em;
      max-width: 22ch;
    }
    .s-word {
      display: inline-block;
      margin-right: 0.25em;
      color: rgba(20, 19, 26, 0.18);
    }

    /* ---------- TRABAJOS ---------- */
    .s-trabajos {
      padding-block: var(--section-y);
    }
    .trabajos-viewport {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .trabajos-viewport::-webkit-scrollbar {
      display: none;
    }
    .trabajos-track {
      display: flex;
      gap: clamp(1rem, 2vw, 1.75rem);
      padding-inline: var(--pad);
      width: max-content;
      will-change: transform;
    }
    .vcard {
      width: min(68vw, 300px);
      flex: 0 0 auto;
    }
    .vmedia {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      background: var(--bg-2);
      border: 1px solid var(--line);
      cursor: pointer;
      padding: 0;
      color: inherit;
      text-decoration: none;
      transition: border-color 0.3s ease;
    }
    .vmedia:hover {
      border-color: var(--fg);
    }
    .vmedia img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .vmedia:hover img {
      transform: scale(1.05);
    }
    .vmedia--soon {
      flex-direction: column;
      gap: var(--sp-s);
      cursor: default;
      background: repeating-linear-gradient(45deg, #dedad1 0 12px, #d5d1c8 12px 24px);
    }
    .vplay {
      position: absolute;
      bottom: 0.9rem;
      right: 0.9rem;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent);
      color: #fff;
      border-radius: 50%;
      transition: transform 0.3s ease;
    }
    .vmedia:hover .vplay {
      transform: scale(1.1);
    }
    .vplay svg {
      width: 17px;
      height: 17px;
      margin-left: 2px;
    }
    /* El glifo de Instagram ya esta centrado: no lleva el ajuste optico del play */
    .vplay--ig svg {
      width: 19px;
      height: 19px;
      margin-left: 0;
    }
    .vplay--ghost {
      position: static;
      background: transparent;
      border: 2px solid var(--accent);
      color: var(--accent);
    }
    .vsoon {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.08em;
      font-size: 0.72rem;
      color: var(--muted);
    }
    :global(.vmedia-iframe) {
      width: 100%;
      aspect-ratio: 9 / 16;
      border: 1px solid var(--line);
      display: block;
      background: #000;
    }
    .vinfo {
      padding-top: var(--sp-s);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-2xs) var(--sp-xs);
    }
    .vindex,
    .vcat {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.04em;
      font-size: 0.68rem;
    }
    .vindex {
      color: var(--muted);
    }
    .vcat {
      color: var(--accent);
    }
    .vtitle {
      flex-basis: 100%;
      font-size: 1rem;
      text-transform: none;
      letter-spacing: -0.01em;
      line-height: 1.15;
    }

    /* ---------- PROCESO ---------- */
    .s-proceso {
      padding-block: var(--section-y);
    }
    .proceso-grid {
      display: grid;
      gap: var(--gap-head);
    }
    /* En móvil el encabezado del proceso fluye normal: al ser sticky en una
       columna corta quedaba medio cortado bajo el nav. */
    .proceso-sticky {
      position: static;
    }
    .proceso-counter {
      display: flex;
      align-items: baseline;
      gap: var(--sp-2xs);
      margin-top: 0;
      font-family: var(--font-mono);
    }
    .proceso-counter #proceso-num {
      font-family: var(--font-display);
      font-weight: var(--w-black);
      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 1;
      color: var(--accent);
    }
    .proceso-total {
      font-size: 0.85rem;
      color: var(--muted);
    }
    .proceso {
      list-style: none;
    }
    .paso {
      position: relative;
      padding-block: var(--sp-l);
    }
    .paso-rule {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: var(--line);
      transform: scaleX(0);
      transform-origin: 0 50%;
      display: block;
    }
    .paso-num {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: var(--sp-xs);
    }
    .paso-body h3 {
      font-size: clamp(1.35rem, 2.6vw, 2rem);
      margin-bottom: var(--sp-2xs);
    }
    .paso-body p {
      color: var(--muted);
      font-size: 0.97rem;
      line-height: 1.6;
      max-width: 52ch;
    }

    /* ---------- SOBRE MÍ ---------- */
    .s-sobre {
      padding-block: var(--section-y);
    }
    .sobre-text p {
      font-size: clamp(1.15rem, 2.1vw, 1.65rem);
      font-weight: var(--w-med);
      line-height: 1.45;
      letter-spacing: -0.01em;
      margin-bottom: var(--sp-m);
    }
    .sobre-text p:last-child {
      margin-bottom: 0;
      color: var(--muted);
      font-size: clamp(1rem, 1.6vw, 1.2rem);
      border-left: 2px solid var(--accent);
      padding-left: 1.15rem;
    }

    /* ---------- CONTACTO ---------- */
    .s-contacto {
      padding-block: var(--section-y);
    }
    .contacto-big {
      font-size: clamp(2rem, 5.5vw, 4.5rem);
      max-width: 18ch;
      margin-bottom: var(--gap-head);
    }
    .contacto-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--sp-l);
      border-top: 1px solid var(--line);
      padding-top: var(--sp-l);
    }
    .contacto-mail {
      position: relative;
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      /* En móvil se ajusta al ancho disponible sin desbordar ni tocar el borde */
      font-size: clamp(0.95rem, 5.2vw, 1.9rem);
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--fg);
      padding-bottom: 0.25em;
      overflow-wrap: anywhere;
      max-width: 100%;
    }
    .contacto-mail .sweep {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 2px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: 0 50%;
      transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
      display: block;
    }
    .contacto-mail:hover {
      color: var(--accent);
    }
    .contacto-mail:hover .sweep {
      transform: scaleX(1);
    }
    .contacto-redes {
      list-style: none;
      display: grid;
      gap: var(--sp-xs);
    }
    .contacto-redes li {
      /* Grid en vez de flex: los usuarios quedan alineados entre sí */
      display: grid;
      grid-template-columns: 9ch auto;
      gap: var(--sp-s);
      align-items: baseline;
    }
    .contacto-redes span {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.06em;
      font-size: 0.66rem;
      color: var(--muted);
    }
    .contacto-redes a {
      font-weight: var(--w-bold);
      text-decoration: none;
      color: var(--fg);
      border-bottom: 1px solid var(--line);
      transition: color 0.25s ease, border-color 0.25s ease;
    }
    .contacto-redes a:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    @media (min-width: 860px) {
      .proceso-grid {
        grid-template-columns: 0.85fr 1.15fr;
      }
      /* En dos columnas sí tiene recorrido para acompañar a los pasos */
      .proceso-sticky {
        position: sticky;
        top: calc(var(--nav-h) + var(--sp-m));
      }
    }

    /* Escritorio: el carrusel se desliza con el scroll (GSAP scrub) */
    @media (min-width: 768px) {
      .trabajos-viewport {
        overflow: hidden;
      }
      .vcard {
        width: 320px;
      }
    }

    body.no-anim .trabajos-viewport {
      overflow-x: auto !important;
    }
    body.no-anim .paso-rule {
      transform: none !important;
    }
  </style>

  <Fragment slot="scripts">
    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ============================================================
         1. Smooth scroll (Lenis) sincronizado con ScrollTrigger
         ============================================================ */
      function initSmoothScroll() {
        if (reduced) return null;
        const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
        return lenis;
      }

      /* ============================================================
         2. Animaciones por sección
         ============================================================ */
      function initAnimations() {
        // Nav sólido al salir del inicio (evita solapes ilegibles).
        // Listener directo: es más fiable que un ScrollTrigger sin trigger.
        const nav = document.getElementById("nav");
        if (nav) {
          const syncNav = () => {
            nav.classList.toggle("is-scrolled", window.scrollY > 40);
          };
          syncNav();
          window.addEventListener("scroll", syncNav, { passive: true });
        }

        // Barra de progreso
        const bar = document.getElementById("scroll-progress-bar");
        if (bar) {
          gsap.to(bar, {
            scaleX: 1,
            ease: "none",
            scrollTrigger: { start: 0, end: "max", scrub: 0.3 },
          });
        }

        if (reduced) return;

        /* ---------- HERO: entrada por máscaras ---------- */
        gsap.set(".hero-title .word", { yPercent: 115 });
        const intro = gsap.timeline({ delay: 0.1 });
        intro.to(".hero-title .word", {
          yPercent: 0,
          duration: 1.05,
          ease: "power4.out",
          stagger: 0.055,
        });
        intro.from(
          "[data-hero]",
          { y: 20, opacity: 0, duration: 0.75, stagger: 0.1, ease: "power3.out" },
          "-=0.65"
        );
        intro.from(".hero-scroll-line", { scaleX: 0, duration: 0.7, ease: "power2.out" }, "-=0.4");

        // Hero: se aleja al scrollear
        gsap.to(".hero-inner", {
          yPercent: -12,
          opacity: 0.15,
          ease: "none",
          scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true },
        });

        /* ---------- TICKER: loop + empuje con el scroll ---------- */
        const track = document.getElementById("ticker-track");
        if (track) {
          const half = track.scrollWidth / 2;
          if (half > 0) {
            const loop = gsap.to(track, {
              x: -half,
              duration: 22,
              ease: "none",
              repeat: -1,
              modifiers: { x: (x) => `${parseFloat(x) % half}px` },
            });
            // El scroll acelera el ticker (efecto Framer)
            ScrollTrigger.create({
              start: 0,
              end: "max",
              onUpdate: (self) => {
                const v = gsap.utils.clamp(-6, 6, self.getVelocity() / 260);
                loop.timeScale(1 + Math.abs(v));
                gsap.to(loop, { timeScale: 1, duration: 0.7, overwrite: true });
              },
            });
          }
        }

        /* ---------- STATEMENT: palabras entintándose ---------- */
        const sWords = gsap.utils.toArray<HTMLElement>("[data-statement]");
        if (sWords.length) {
          gsap.to(sWords, {
            color: "rgba(20,19,26,1)",
            stagger: 0.08,
            ease: "none",
            scrollTrigger: {
              trigger: ".statement",
              start: "top 78%",
              end: "bottom 62%",
              scrub: true,
            },
          });
        }

        /* ---------- Reveals genéricos (solo opacidad) ---------- */
        gsap.set("[data-reveal]", { opacity: 0, y: 18 });
        ScrollTrigger.batch("[data-reveal]", {
          start: "top 92%",
          onEnter: (els) =>
            gsap.to(els, {
              opacity: 1,
              y: 0,
              duration: 0.85,
              ease: "power3.out",
              stagger: 0.08,
              overwrite: "auto",
            }),
        });

        /* ---------- Parallax continuo (data-speed) ---------- */
        gsap.utils.toArray<HTMLElement>("[data-speed]").forEach((el) => {
          const speed = parseFloat(el.dataset.speed || "0");
          if (!speed) return;
          gsap.fromTo(
            el,
            { y: speed * 60 },
            {
              y: -speed * 60,
              ease: "none",
              scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true },
            }
          );
        });

        /* ---------- TRABAJOS: carrusel que se desliza al bajar ---------- */
        const mm = gsap.matchMedia();
        mm.add("(min-width: 768px)", () => {
          const cards = document.getElementById("trabajos-track");
          const viewport = document.querySelector<HTMLElement>(".trabajos-viewport");
          if (!cards || !viewport) return;
          const overflow = () => Math.max(0, cards.scrollWidth - viewport.clientWidth);
          gsap.fromTo(
            cards,
            { x: 0 },
            {
              x: () => -overflow(),
              ease: "none",
              scrollTrigger: {
                trigger: ".s-trabajos",
                start: "top bottom",
                end: "bottom top",
                scrub: 0.6,
                invalidateOnRefresh: true,
              },
            }
          );
        });

        /* ---------- PROCESO: reglas que se dibujan, líneas que suben
                       y contador pegajoso que cambia por paso ---------- */
        const pasos = gsap.utils.toArray<HTMLElement>(".paso");
        const numEl = document.getElementById("proceso-num");
        pasos.forEach((paso) => {
          const rule = paso.querySelector(".paso-rule");
          const lines = paso.querySelectorAll(".line-inner");
          const num = paso.dataset.paso || "01";

          gsap.set(lines, { yPercent: 105, opacity: 0 });

          ScrollTrigger.create({
            trigger: paso,
            start: "top 85%",
            once: true,
            onEnter: () => {
              if (rule) gsap.to(rule, { scaleX: 1, duration: 1, ease: "power3.out" });
              gsap.to(lines, {
                yPercent: 0,
                opacity: 1,
                duration: 0.85,
                ease: "power3.out",
                stagger: 0.09,
              });
            },
          });

          // Contador que sigue al paso activo
          if (numEl) {
            ScrollTrigger.create({
              trigger: paso,
              start: "top 55%",
              end: "bottom 55%",
              onToggle: (self) => {
                if (!self.isActive) return;
                if (numEl.textContent === num) return;
                gsap.fromTo(
                  numEl,
                  { yPercent: 45, opacity: 0 },
                  { yPercent: 0, opacity: 1, duration: 0.45, ease: "power3.out" }
                );
                numEl.textContent = num;
              },
            });
          }
        });

        /* ---------- SOBRE MÍ: párrafos que suben por máscara ---------- */
        const sobreLines = gsap.utils.toArray<HTMLElement>(".s-sobre .line-inner");
        if (sobreLines.length) {
          gsap.set(sobreLines, { yPercent: 105, opacity: 0 });
          ScrollTrigger.create({
            trigger: ".s-sobre",
            start: "top 78%",
            once: true,
            onEnter: () =>
              gsap.to(sobreLines, {
                yPercent: 0,
                opacity: 1,
                duration: 0.95,
                ease: "power3.out",
                stagger: 0.12,
              }),
          });
        }

        /* ---------- CONTACTO: titular por máscaras ---------- */
        const cWords = gsap.utils.toArray<HTMLElement>(".word--c");
        if (cWords.length) {
          gsap.set(cWords, { yPercent: 115 });
          ScrollTrigger.create({
            trigger: ".s-contacto",
            start: "top 72%",
            once: true,
            onEnter: () =>
              gsap.to(cWords, { yPercent: 0, duration: 1, ease: "power4.out", stagger: 0.045 }),
          });
        }
      }

      /* ============================================================
         3. Facade de video: al hacer clic, carga el iframe
         ============================================================ */
      function initVideoFacade() {
        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          const media = target.closest<HTMLElement>(".vmedia[data-embed]");
          if (!media) return;
          const src = media.getAttribute("data-embed");
          if (!src) return;
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.className = "vmedia-iframe";
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "");
          iframe.setAttribute("title", media.getAttribute("aria-label") ?? "Video");
          media.replaceWith(iframe);
          ScrollTrigger.refresh();
        });
      }

      /* ============================================================
         4. Anchors con smooth scroll
         ============================================================ */
      function initAnchors(lenis: Lenis | null) {
        // Altura real del nav: el destino nunca queda tapado por él
        const navOffset = () => {
          const nav = document.getElementById("nav");
          return nav ? -nav.getBoundingClientRect().height : 0;
        };
        document.querySelectorAll<HTMLAnchorElement>("a[data-scroll]").forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href");
            if (!id || !id.startsWith("#")) return;
            const el = document.querySelector(id);
            if (!el) return;
            e.preventDefault();
            const offset = id === "#top" ? 0 : navOffset();
            if (lenis) lenis.scrollTo(el as HTMLElement, { offset });
            else (el as HTMLElement).scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
          });
        });
      }

      /* ---------- Arranque (con red de seguridad de legibilidad) ---------- */
      if (reduced) document.body.classList.add("no-anim");
      try {
        const lenis = initSmoothScroll();
        initAnimations();
        initVideoFacade();
        initAnchors(lenis);
        window.addEventListener("load", () => ScrollTrigger.refresh());
      } catch (err) {
        // Si algo falla, el contenido nunca se queda invisible
        document.body.classList.add("no-anim");
        console.error(err);
      }
    </script>
  </Fragment>
</Immersive>
