---
import Layout from "../components/Layout.astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import ServiceCard from "../components/ServiceCard.astro";
// import VideoCard from "../components/VideoCard.astro"; // reactivar con la sección Trabajos
import { PERFIL, SERVICIOS, PROCESO, CONTACTO } from "../data/portfolio";
// import { VIDEOS } from "../data/portfolio"; // reactivar con la sección Trabajos
---

<Layout>
  <!-- Hero -->
  <Section>
    <Container>
      <div class="hero">
        <div class="hero-encabezado">
          <div>
            <h1 class="hero-nombre">{PERFIL.nombre}</h1>
            <p class="hero-rol">{PERFIL.rol}</p>
          </div>
          <div class="hero-detalles">
            {PERFIL.ubicacion && <p>{PERFIL.ubicacion}</p>}
            <p class="hero-disponibilidad">{PERFIL.disponibilidad}</p>
          </div>
        </div>

        <div class="hero-titular">
          <h2>{PERFIL.titular}</h2>
          <p>{PERFIL.subtitular}</p>
        </div>

        <div class="hero-acciones">
          <a class="boton" href={`mailto:${CONTACTO.email}`}>Trabajemos juntos</a>
        </div>

        {/*
          METRICAS DEL HERO (ocultas por ahora).
          Eran números de ejemplo en ceros. Para alguien que está
          empezando, mostrar cifras vacías resta credibilidad. Reactiva
          este bloque cuando tengas números reales que aporten,
          definiéndolos en una constante METRICAS en portfolio.ts.
        */}
      </div>
    </Container>
  </Section>

  {/*
    ============================================================
    SECCIÓN "TRABAJOS" (oculta hasta tener 2-3 videos reales)
    ============================================================
    Cómo reactivarla cuando haya videos reales:
      1. Descomenta los imports de VideoCard y VIDEOS arriba.
      2. Añade objetos Video reales en portfolio.ts (VIDEOS).
      3. Descomenta el bloque de abajo.
      4. Vuelve a poner el link "Trabajos" en el menú (Layout.astro).

    Requisitos del diseño al reactivar:
      - Carousel horizontal con scroll en móvil (clase .carousel, ya lista).
      - Sin métricas inventadas (no inventes cifras de vistas ni de CTR).
      - Cada tarjeta con link real al video (fuente + videoId reales).
      - La descripción debe enfocarse en el objetivo que buscaba la marca
        con el video (qué querían lograr), no solo describir la escena.

    <Section id="trabajos">
      <Container>
        <h2 class="section-title">Trabajos</h2>
        <div class="carousel" style="--cols: 3">
          {VIDEOS.map((video) => <VideoCard video={video} />)}
        </div>
      </Container>
    </Section>
  */}

  <!-- Servicios -->
  <Section id="servicios">
    <Container>
      <h2 class="section-title">Servicios</h2>
      <div class="servicios">
        {SERVICIOS.map((servicio) => <ServiceCard servicio={servicio} />)}
      </div>
    </Container>
  </Section>

  <!-- Proceso -->
  <Section id="proceso">
    <Container>
      <h2 class="section-title">Cómo trabajo</h2>
      <ol class="proceso">
        {
          PROCESO.map((paso, indice) => (
            <li class="paso">
              <span class="paso-numero">{String(indice + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="paso-titulo">{paso.titulo}</h3>
                <p class="paso-descripcion">{paso.descripcion}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <!-- Sobre mí -->
  <Section id="sobre-mi">
    <Container>
      <h2 class="section-title">Sobre mí</h2>
      <div class="sobre-mi">
        {PERFIL.sobre_mi.map((parrafo) => <p>{parrafo}</p>)}
      </div>
    </Container>
  </Section>

  <!-- Contacto -->
  <Section id="contacto" fondo="suave">
    <Container>
      <h2 class="section-title">Contacto</h2>
      <p class="contacto-cierre">{CONTACTO.cierre}</p>
      <ul class="contacto-lista">
        <li>
          <span class="contacto-etiqueta">Email</span>
          <a href={`mailto:${CONTACTO.email}`}>{CONTACTO.email}</a>
        </li>
        <li>
          <span class="contacto-etiqueta">Instagram</span>
          <a href={CONTACTO.instagram.url} target="_blank" rel="noopener">
            {CONTACTO.instagram.usuario}
          </a>
        </li>
        <li>
          <span class="contacto-etiqueta">TikTok</span>
          <a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">
            {CONTACTO.tiktok.usuario}
          </a>
        </li>
        {
          CONTACTO.whatsapp && (
            <li>
              <span class="contacto-etiqueta">WhatsApp</span>
              <a
                href={`https://wa.me/${CONTACTO.whatsapp.replace(/\D/g, "")}`}
                target="_blank"
                rel="noopener"
              >
                {CONTACTO.whatsapp}
              </a>
            </li>
          )
        }
      </ul>
    </Container>
  </Section>
</Layout>

<style>
  /* ------------------------------------------------------------------ */
  /* Hero                                                                */
  /* ------------------------------------------------------------------ */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .hero-encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: var(--border-thick) solid var(--color-border);
  }

  .hero-nombre {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-1);
  }

  .hero-rol {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-secondary);
  }

  .hero-detalles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .hero-detalles p {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
  }

  .hero-disponibilidad {
    color: #000 !important;
    background: var(--color-accent);
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin) solid var(--color-border);
  }

  .hero-titular h2 {
    font-size: clamp(2.75rem, 11vw, var(--text-4xl));
    font-weight: var(--font-bold);
    text-transform: uppercase;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
    margin-bottom: var(--space-5);
  }

  .hero-titular p {
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    color: var(--color-text-body);
    max-width: 40ch;
  }

  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .boton {
    display: inline-block;
    padding: var(--space-4) var(--space-8);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    background-color: var(--color-primary);
    color: #fff;
    border: var(--border-thick) solid var(--color-border);
    box-shadow: var(--shadow-hard);
    transition: transform var(--transition-elegant), box-shadow var(--transition-elegant), background-color var(--transition-elegant);
  }

  .boton:hover {
    background-color: var(--color-primary-hover);
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 var(--color-border);
  }

  /* ------------------------------------------------------------------ */
  /* Servicios                                                          */
  /* ------------------------------------------------------------------ */
  .servicios {
    display: grid;
    gap: var(--space-4);
  }

  /* ------------------------------------------------------------------ */
  /* Proceso                                                            */
  /* ------------------------------------------------------------------ */
  .proceso {
    list-style: none;
    display: grid;
    gap: var(--space-6);
  }

  .paso {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .paso-numero {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: #fff;
    background: var(--color-primary);
    border: var(--border-thin) solid var(--color-border);
    line-height: 1;
    padding: var(--space-2);
    min-width: 2.4em;
    text-align: center;
    flex-shrink: 0;
  }

  .paso-titulo {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .paso-descripcion {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
  }

  /* ------------------------------------------------------------------ */
  /* Sobre mí                                                           */
  /* ------------------------------------------------------------------ */
  .sobre-mi {
    max-width: 60ch;
  }

  .sobre-mi p {
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    color: var(--color-text-body);
    margin-bottom: var(--space-5);
  }

  .sobre-mi p:first-child {
    font-size: var(--text-lg);
  }

  .sobre-mi p:last-child {
    margin-bottom: 0;
    font-weight: var(--font-bold);
    border-left: var(--border-thick) solid var(--color-primary);
    padding-left: var(--space-4);
  }

  /* ------------------------------------------------------------------ */
  /* Contacto                                                           */
  /* ------------------------------------------------------------------ */
  .contacto-cierre {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    line-height: var(--line-height-snug);
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
    max-width: 20ch;
  }

  .contacto-lista {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .contacto-lista li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contacto-etiqueta {
    font-size: var(--text-2xs);
    font-weight: var(--font-bold);
    color: #fff;
    background: var(--color-text-primary);
    padding: var(--space-1) var(--space-2);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    min-width: 8ch;
    text-align: center;
  }

  .contacto-lista a {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: var(--border-thin) solid var(--color-border);
    transition: color var(--transition-elegant), border-color var(--transition-elegant);
  }

  .contacto-lista a:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* ------------------------------------------------------------------ */
  /* Responsive                                                         */
  /* ------------------------------------------------------------------ */
  @media (min-width: 481px) {
    .hero-encabezado {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .hero-detalles {
      align-items: flex-end;
    }

    .hero-nombre {
      font-size: var(--text-xl);
    }
  }

  @media (min-width: 640px) {
    .servicios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
