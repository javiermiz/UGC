---
import Immersive from "../layouts/Immersive.astro";
import { PERFIL, VIDEOS, INCLUYE, PROCESO, CONTACTO } from "../data/portfolio";

/* Datos de reproducción de cada video (nada se aloja aquí; se incrusta) */
/* `oardefault` conserva la proporción original del video, que en un Short es
   9:16 y encaja con la tarjeta sin recortes. No existe para todos los videos,
   así que `hqdefault` (4:3, siempre disponible) queda de red: el <img> cambia
   a la de reserva si la primera falla. */
function youtubeThumb(id: string) {
  return `https://i.ytimg.com/vi/${id}/oardefault.jpg`;
}
function youtubeThumbReserva(id: string) {
  return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
}
const videos = VIDEOS.map((v) => {
  const esReal = Boolean(v.fuente && v.videoId);
  let thumb = v.thumbnail ?? "";
  let thumbReserva = "";
  let embed = "";
  let enlace = "";
  if (esReal) {
    const id = v.videoId as string;
    if (v.fuente === "youtube") {
      thumb = v.thumbnail ?? youtubeThumb(id);
      thumbReserva = v.thumbnail ? "" : youtubeThumbReserva(id);
      embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      enlace = `https://youtu.be/${id}`;
    } else if (v.fuente === "vimeo") {
      embed = `https://player.vimeo.com/video/${id}?autoplay=1`;
      enlace = `https://vimeo.com/${id}`;
    } else {
      enlace = id;
    }
  }
  return { ...v, esReal, thumb, thumbReserva, embed, enlace, puedeIncrustar: embed !== "" };
});

const tituloPalabras = PERFIL.titular.replace(/\.$/, "").split(" ");
const TICKER = [
  "Video UGC",
  "Reels",
  "TikTok",
  "YouTube Shorts",
  "Guion y hooks",
  "Grabación",
  "Edición",
];
---

<Immersive>
  <!-- ===================== HERO ===================== -->
  <section class="hero" id="top">
    <div class="hero-inner">
      <div class="hero-kicker" data-hero>
        <span class="tag">{PERFIL.rol}</span>
        <span class="tag tag--accent">{PERFIL.disponibilidad}</span>
      </div>

      <h1 class="hero-title">
        {
          tituloPalabras.map((w) => (
            <span class="word-mask">
              <span class="word">{w}</span>
            </span>
          ))
        }
      </h1>

      <div class="hero-foot">
        <p class="hero-sub" data-hero>{PERFIL.subtitular}</p>
        {/* Al correo directo, sin pasar por la sección de contacto: quien ya
            está convencido no tiene por qué recorrer la página entera. */}
        <a class="hero-cta" href={`mailto:${CONTACTO.email}`} data-hero>
          <span>Escríbeme</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== TICKER ===================== -->
  <section class="ticker" aria-hidden="true">
    <div class="ticker-track" id="ticker-track">
      {
        [0, 1].map(() => (
          <div class="ticker-group">
            {TICKER.map((t) => (
              <span class="ticker-item">
                {t}
                <i class="ticker-dot" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== TRABAJOS ===================== -->
  <section class="s-trabajos" id="trabajos">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow" data-reveal>01 / Trabajos</span>
        <h2 class="s-title" data-reveal data-speed="0.16">Videos recientes</h2>
      </div>
    </div>

    <div class="trabajos-viewport">
      <div class="trabajos-track" id="trabajos-track">
        {
          videos.map((v, i) => (
            <article class="vcard" data-card data-speed={String(i % 2 === 0 ? 0.1 : 0.22)}>
              {v.esReal ? (
                v.puedeIncrustar ? (
                  <button
                    type="button"
                    class="vmedia"
                    data-embed={v.embed}
                    aria-label={`Reproducir: ${v.titulo ?? "video"}`}
                  >
                    <img
                      src={v.thumb}
                      alt={`Miniatura de ${v.titulo ?? "video"}`}
                      loading="lazy"
                      data-reserva={v.thumbReserva}
                    />
                    <span class="vplay" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  </button>
                ) : (
                  <a
                    class="vmedia"
                    href={v.enlace}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Ver en ${v.fuente === "tiktok" ? "TikTok" : "Instagram"}: ${v.titulo ?? "video"}`}
                  >
                    <img src={v.thumb} alt={`Portada de ${v.titulo ?? "video"}`} loading="lazy" />
                    <span class={v.fuente === "instagram" ? "vplay vplay--ig" : "vplay"} aria-hidden="true">
                      {v.fuente === "instagram" ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="3" y="3" width="18" height="18" rx="5" />
                          <circle cx="12" cy="12" r="4" />
                          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      )}
                    </span>
                  </a>
                )
              ) : (
                <div class="vmedia vmedia--soon">
                  <span class="vplay vplay--ghost" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                  <span class="vsoon">Próximamente</span>
                </div>
              )}
              <div class="vinfo">
                <span class="vindex">{String(i + 1).padStart(2, "0")}</span>
                {v.categoria && <span class="vcat">{v.categoria}</span>}
                {v.titulo && <h3 class="vtitle">{v.titulo}</h3>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== QUÉ RECIBES ===================== -->
  <section class="s-incluye">
    <div class="wrap incluye-grid">
      <div class="incluye-head">
        <span class="eyebrow" data-reveal>02 / Qué recibes</span>
        <h2 class="s-title" data-reveal>Qué incluye un video</h2>
      </div>
      <ul class="incluye-lista">
        {
          INCLUYE.map((punto, i) => (
            <li class="incluye-item" data-reveal>
              <span class="incluye-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="incluye-texto">{punto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== PROCESO ===================== -->
  <section class="s-proceso">
    <div class="wrap proceso-grid">
      <div class="proceso-aside">
        <div class="proceso-sticky">
          <span class="eyebrow" data-reveal>03 / Proceso</span>
          <h2 class="s-title" data-reveal>De la idea a la entrega</h2>
          <div class="proceso-counter" aria-hidden="true">
            <span id="proceso-num">01</span>
            <span class="proceso-total">/ {String(PROCESO.length).padStart(2, "0")}</span>
          </div>
        </div>
      </div>

      <div class="proceso-col">
        {/* Riel de progreso: se rellena con el scroll y marca el paso activo */}
        <span class="proceso-rail" aria-hidden="true">
          <i class="proceso-rail-fill"></i>
        </span>
        <ol class="proceso">
          {
            PROCESO.map((p, i) => (
              <li class="paso" data-paso={String(i + 1).padStart(2, "0")}>
                <span class="paso-rule" aria-hidden="true" />
                <span class="paso-dot" aria-hidden="true" />
                <div class="paso-body">
                  <span class="paso-num">{String(i + 1).padStart(2, "0")}</span>
                  <h3 class="line"><span class="line-inner">{p.titulo}</span></h3>
                  <p class="line"><span class="line-inner">{p.descripcion}</span></p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ===================== SOBRE MÍ ===================== -->
  <section class="s-sobre" id="sobre">
    <div class="wrap sobre-grid">
      <div class="sobre-aside">
        <div class="sobre-sticky">
          <span class="eyebrow" data-reveal>04 / Sobre mí</span>
          <h2 class="s-title" data-reveal>{PERFIL.sobre_titulo}</h2>
          {
            PERFIL.sobre_datos.length > 0 && (
              <ul class="sobre-datos" data-reveal>
                {PERFIL.sobre_datos.map((d) => (
                  <li class="dato">
                    <span class="dato-k">{d.clave}</span>
                    <span class="dato-v">{d.valor}</span>
                  </li>
                ))}
              </ul>
            )
          }
          {
            PERFIL.disponibilidad && (
              <p class="sobre-estado" data-reveal>
                <i class="estado-punto" aria-hidden="true" />
                {PERFIL.disponibilidad}
              </p>
            )
          }
        </div>
      </div>

      <div class="sobre-col">
        <div class="sobre-text">
          {
            PERFIL.sobre_mi.map((p, i) => (
              <p class={i === 0 ? "line sobre-lead" : "line sobre-p"}>
                <span class="line-inner">{p}</span>
              </p>
            ))
          }
        </div>

        {
          PERFIL.sobre_nota && (
            <aside class="sobre-nota" data-reveal>
              <span class="sobre-nota-k">{PERFIL.sobre_nota_etiqueta}</span>
              <p>{PERFIL.sobre_nota}</p>
            </aside>
          )
        }
      </div>
    </div>
  </section>

  <!-- ===================== CONTACTO ===================== -->
  <section class="s-contacto" id="contacto">
    <div class="wrap">
      <span class="eyebrow" data-reveal>05 / Contacto</span>
      <h2 class="contacto-big">
        {
          CONTACTO.cierre.split(" ").map((w) => (
            <span class="word-mask">
              <span class="word word--c">{w}</span>
            </span>
          ))
        }
      </h2>

      {
        CONTACTO.instrucciones && (
          <p class="contacto-nota" data-reveal>{CONTACTO.instrucciones}</p>
        )
      }

      <div class="contacto-grid" data-reveal>
        <a class="contacto-mail" href={`mailto:${CONTACTO.email}`}>
          <span>{CONTACTO.email}</span>
          <i class="sweep" aria-hidden="true"></i>
        </a>
        <ul class="contacto-redes">
          <li><span>Instagram</span><a href={CONTACTO.instagram.url} target="_blank" rel="noopener">{CONTACTO.instagram.usuario}</a></li>
          <li><span>TikTok</span><a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">{CONTACTO.tiktok.usuario}</a></li>
        </ul>
      </div>
    </div>
  </section>

  <style>
    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding-inline: var(--pad);
    }

    /* Ritmo de encabezado idéntico en todas las secciones:
       eyebrow -> (gap-eyebrow) -> título -> (gap-head) -> contenido */
    .eyebrow {
      display: block;
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.12em;
      font-size: 0.72rem;
      color: var(--accent);
      margin-bottom: var(--gap-eyebrow);
    }

    .s-title {
      font-size: clamp(2.25rem, 6vw, 4.5rem);
      text-wrap: balance;
      margin-bottom: var(--gap-head);
    }
    /* El .head solo agrupa; los márgenes los ponen sus hijos */
    .head > :last-child {
      margin-bottom: 0;
    }
    .head {
      margin-bottom: var(--gap-head);
    }

    /* Máscaras de palabra (hero y contacto) */
    .word-mask {
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
      padding-right: 0.22em;
      /* Igual que .line: deja aire para las tildes sin alterar el layout */
      padding-top: 0.14em;
      margin-top: -0.14em;
    }
    .word {
      display: inline-block;
      will-change: transform;
    }

    /* Líneas con máscara (proceso y sobre mí).
       El padding evita que la máscara recorte tildes y mayúsculas
       acentuadas (p. ej. GRABACIÓN); el margen negativo lo compensa. */
    .line {
      overflow: hidden;
      padding-top: 0.18em;
      margin-top: -0.18em;
    }
    .line-inner {
      display: block;
      will-change: transform;
    }

    /* ---------- HERO ---------- */
    /* A media pantalla, no completa: en un portfolio los videos son el
       argumento de venta, así que tienen que asomar sin hacer scroll.
       Un hero de 100svh los esconde y obliga a un acto de fe. */
    .hero {
      position: relative;
      min-height: 58svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--pad);
      padding-top: calc(var(--nav-h) + var(--sp-l));
      padding-bottom: var(--sp-l);
    }
    .hero-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      width: 100%;
    }
    .hero-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2xs) var(--sp-xs);
      margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
    }
    .tag {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.03em;
      font-size: 0.72rem;
      padding: 0.45em 0.75em;
      border: 1px solid var(--line);
      color: var(--muted);
    }
    .tag--accent {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    /* Más contenido y menos alto que antes: con el hero a media pantalla,
       un cuerpo de 7rem se comía el fold entero y los videos no asomaban. */
    .hero-title {
      font-size: clamp(2rem, 5.4vw, 4.5rem);
      line-height: 0.96;
      letter-spacing: -0.035em;
      /* 26ch lo deja en dos líneas en escritorio; con 20ch caía en tres y
         empujaba las tarjetas fuera de la pantalla. */
      max-width: 26ch;
    }
    .hero-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--sp-l);
      margin-top: clamp(1.75rem, 4vw, 2.75rem);
    }
    .hero-sub {
      max-width: 46ch;
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.5;
      font-weight: var(--w-med);
      color: var(--muted);
    }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-xs);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.03em;
      text-decoration: none;
      color: #fff;
      background: var(--fg);
      padding: 1em 1.5em;
      transition: background 0.3s ease;
      white-space: nowrap;
    }
    .hero-cta svg {
      width: 16px;
      height: 16px;
      transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .hero-cta:hover {
      background: var(--accent);
    }
    .hero-cta:hover svg {
      transform: translateX(5px);
    }
    /* ---------- TICKER ---------- */
    .ticker {
      border-block: 1px solid var(--line);
      padding-block: var(--sp-m);
      overflow: hidden;
    }
    .ticker-track {
      display: flex;
      width: max-content;
      will-change: transform;
    }
    .ticker-group {
      display: flex;
      align-items: center;
    }
    .ticker-item {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-m);
      padding-right: var(--sp-m);
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      font-size: clamp(1.1rem, 2.2vw, 1.7rem);
      color: var(--fg);
      white-space: nowrap;
    }
    .ticker-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      flex: 0 0 auto;
    }

    /* ---------- TRABAJOS ---------- */
    /* Arriba respira menos que el resto de secciones a propósito: es lo que
       hace que las tarjetas asomen bajo el hero sin tener que scrollear. */
    .s-trabajos {
      padding-top: var(--sp-l);
      padding-bottom: var(--section-y);
    }
    .s-trabajos .head {
      margin-bottom: var(--sp-l);
    }
    .trabajos-viewport {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .trabajos-viewport::-webkit-scrollbar {
      display: none;
    }
    .trabajos-track {
      display: flex;
      gap: clamp(1rem, 2vw, 1.75rem);
      padding-inline: var(--pad);
      width: max-content;
      will-change: transform;
    }
    .vcard {
      width: min(68vw, 300px);
      flex: 0 0 auto;
    }
    .vmedia {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      background: var(--bg-2);
      border: 1px solid var(--line);
      cursor: pointer;
      padding: 0;
      color: inherit;
      text-decoration: none;
      transition: border-color 0.3s ease;
    }
    .vmedia:hover {
      border-color: var(--fg);
    }
    .vmedia img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .vmedia:hover img {
      transform: scale(1.05);
    }
    .vmedia--soon {
      flex-direction: column;
      gap: var(--sp-s);
      cursor: default;
      background: repeating-linear-gradient(45deg, #dedad1 0 12px, #d5d1c8 12px 24px);
    }
    .vplay {
      position: absolute;
      bottom: 0.9rem;
      right: 0.9rem;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent);
      color: #fff;
      border-radius: 50%;
      transition: transform 0.3s ease;
    }
    .vmedia:hover .vplay {
      transform: scale(1.1);
    }
    .vplay svg {
      width: 17px;
      height: 17px;
      margin-left: 2px;
    }
    /* El glifo de Instagram ya esta centrado: no lleva el ajuste optico del play */
    .vplay--ig svg {
      width: 19px;
      height: 19px;
      margin-left: 0;
    }
    .vplay--ghost {
      position: static;
      background: transparent;
      border: 2px solid var(--accent);
      color: var(--accent);
    }
    .vsoon {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.08em;
      font-size: 0.72rem;
      color: var(--muted);
    }
    :global(.vmedia-iframe) {
      width: 100%;
      aspect-ratio: 9 / 16;
      border: 1px solid var(--line);
      display: block;
      background: #000;
    }
    .vinfo {
      padding-top: var(--sp-s);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-2xs) var(--sp-xs);
    }
    .vindex,
    .vcat {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.04em;
      font-size: 0.68rem;
    }
    .vindex {
      color: var(--muted);
    }
    .vcat {
      color: var(--accent);
    }
    .vtitle {
      flex-basis: 100%;
      font-size: 1rem;
      text-transform: none;
      letter-spacing: -0.01em;
      line-height: 1.15;
    }

    /* ---------- QUÉ RECIBES ---------- */
    .s-incluye {
      padding-block: var(--section-y);
      border-top: 1px solid var(--line);
    }
    .incluye-grid {
      display: grid;
      gap: var(--gap-head);
    }
    .incluye-lista {
      list-style: none;
      border-top: 1px solid var(--line);
    }
    /* Lista con filete, no tarjetas: son condiciones que se leen de un
       vistazo, no piezas que compiten entre sí. */
    .incluye-item {
      display: flex;
      gap: var(--sp-m);
      align-items: baseline;
      padding-block: var(--sp-m);
      border-bottom: 1px solid var(--line);
    }
    .incluye-num {
      flex: none;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      color: var(--accent);
    }
    .incluye-texto {
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.5;
      font-weight: var(--w-med);
      max-width: 52ch;
    }

    /* ---------- PROCESO ---------- */
    .s-proceso {
      padding-block: var(--section-y);
    }
    .proceso-grid {
      display: grid;
      gap: var(--gap-head);
    }
    /* En móvil el encabezado del proceso fluye normal: al ser sticky en una
       columna corta quedaba medio cortado bajo el nav. */
    .proceso-sticky {
      position: static;
    }
    .proceso-counter {
      display: flex;
      align-items: baseline;
      gap: var(--sp-2xs);
      margin-top: 0;
      font-family: var(--font-mono);
    }
    .proceso-counter #proceso-num {
      font-family: var(--font-display);
      font-weight: var(--w-black);
      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 1;
      color: var(--accent);
    }
    .proceso-total {
      font-size: 0.85rem;
      color: var(--muted);
    }
    .proceso-col {
      position: relative;
    }
    /* Riel y puntos solo en escritorio: en una columna estrecha se comen
       ancho de texto sin aportar. Se activan en el @media de abajo. */
    .proceso-rail {
      display: none;
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--line);
    }
    .proceso-rail-fill {
      display: block;
      position: absolute;
      inset: 0;
      background: var(--accent);
      transform: scaleY(0);
      transform-origin: 50% 0;
    }
    .proceso {
      list-style: none;
    }
    .paso {
      position: relative;
      padding-block: var(--sp-l);
      transition: opacity 0.45s ease;
    }
    /* Atenuar los inactivos es lo que hace visible el avance; en móvil, donde
       no hay riel ni contador a la vista, es la única señal, así que se queda
       más suave para no estorbar la lectura. Sin animaciones, todo a plena
       opacidad. */
    body:not(.no-anim) .paso {
      opacity: 0.45;
    }
    body:not(.no-anim) .paso.is-activo {
      opacity: 1;
    }
    .paso-dot {
      display: none;
      position: absolute;
      top: calc(var(--sp-l) + 0.35em);
      left: calc(var(--rail-gap) * -1 + 1px);
      width: 11px;
      height: 11px;
      transform: translateX(-50%);
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--line);
      transition: background-color 0.45s ease, border-color 0.45s ease,
        transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .paso.is-activo .paso-dot {
      background: var(--accent);
      border-color: var(--accent);
      transform: translateX(-50%) scale(1.35);
    }
    .paso-rule {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: var(--line);
      transform: scaleX(0);
      transform-origin: 0 50%;
      display: block;
    }
    .paso-num {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: var(--sp-xs);
    }
    .paso-body h3 {
      font-size: clamp(1.35rem, 2.6vw, 2rem);
      margin-bottom: var(--sp-2xs);
    }
    .paso-body p {
      color: var(--muted);
      font-size: 0.97rem;
      line-height: 1.6;
      max-width: 52ch;
    }

    /* ---------- SOBRE MÍ ---------- */
    .s-sobre {
      padding-block: var(--section-y);
    }
    /* Misma retícula que el proceso: encabezado a un lado, contenido al otro.
       Antes era un bloque centrado de texto a un solo tamaño, sin título de
       sección ni jerarquía, y quedaba como un muro de letra. */
    .sobre-grid {
      display: grid;
      gap: var(--gap-head);
    }
    .sobre-sticky {
      position: static;
    }
    /* El título manda menos que el de Trabajos o Proceso: aquí la voz la
       lleva el párrafo grande de al lado, no el encabezado. */
    .sobre-aside .s-title {
      font-size: clamp(2rem, 4.6vw, 3.25rem);
      margin-bottom: var(--sp-l);
    }

    /* Ficha rápida: da textura al lateral y resume el perfil para quien
       escanea la página sin leer los párrafos. */
    .sobre-datos {
      list-style: none;
      border-top: 1px solid var(--line);
    }
    .dato {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--sp-s);
      padding-block: 0.7rem;
      border-bottom: 1px solid var(--line);
    }
    .dato-k {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      white-space: nowrap;
    }
    .dato-v {
      font-weight: var(--w-med);
      font-size: 0.92rem;
      text-align: right;
      text-wrap: balance;
    }

    /* Cierra la ficha y evita que el lateral quede en blanco bajo la lista */
    .sobre-estado {
      display: flex;
      align-items: center;
      gap: var(--sp-2xs);
      margin-top: var(--sp-m);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--muted);
    }
    .estado-punto {
      width: 7px;
      height: 7px;
      flex: none;
      border-radius: 50%;
      background: var(--accent);
    }

    /* Una entrada grande y el resto en cuerpo de lectura: la jerarquía es
       lo que hace que el bloque se lea en vez de saltarse. */
    .sobre-lead {
      /* Grande, pero no tanto como para volver a ser un muro: por encima de
         esto la entradilla cae en siete líneas y pierde el golpe. */
      font-size: clamp(1.3rem, 2.3vw, 1.8rem);
      font-weight: var(--w-bold);
      line-height: 1.25;
      letter-spacing: -0.02em;
      margin-bottom: var(--sp-l);
      max-width: 28ch;
    }
    .sobre-p {
      font-size: clamp(1rem, 1.5vw, 1.12rem);
      line-height: 1.65;
      color: var(--muted);
      max-width: 54ch;
      margin-bottom: var(--sp-m);
    }
    .sobre-p:last-child {
      margin-bottom: 0;
    }

    /* Recuadro aparte: es un argumento de venta, no parte del relato, así
       que se separa del texto en vez de ir con un filete fino. */
    .sobre-nota {
      margin-top: var(--gap-head);
      padding: var(--sp-m);
      background: var(--bg-2);
      border-left: 2px solid var(--accent);
      max-width: 54ch;
    }
    .sobre-nota-k {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: var(--sp-2xs);
    }
    .sobre-nota p {
      font-size: 1rem;
      line-height: 1.6;
      font-weight: var(--w-med);
    }

    /* ---------- CONTACTO ---------- */
    .s-contacto {
      padding-block: var(--section-y);
    }
    .contacto-big {
      /* Es el único titular de varias líneas: 18ch lo partía en seis líneas de
         tres palabras y dejaba media sección vacía a la derecha. Con más ancho
         y algo menos de cuerpo cae en tres o cuatro líneas y se lee de corrido. */
      font-size: clamp(1.75rem, 4.4vw, 3.75rem);
      max-width: 26ch;
      /* El 0.94 global junta demasiado las líneas y las tildes de QUÉ o
         ESCRÍBEME chocan con la línea de arriba. */
      line-height: 1.02;
      margin-bottom: var(--sp-m);
    }
    /* Hace el trabajo de un formulario sin poner uno: el correo llega ya
       con lo que hace falta para poder contestarlo. */
    .contacto-nota {
      color: var(--muted);
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      max-width: 46ch;
      margin-bottom: var(--gap-head);
    }
    .contacto-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--sp-l);
      border-top: 1px solid var(--line);
      padding-top: var(--sp-l);
    }
    .contacto-mail {
      position: relative;
      font-family: var(--font-display);
      font-weight: var(--w-bold);
      text-transform: uppercase;
      /* En móvil se ajusta al ancho disponible sin desbordar ni tocar el borde */
      font-size: clamp(0.95rem, 5.2vw, 1.9rem);
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--fg);
      padding-bottom: 0.25em;
      overflow-wrap: anywhere;
      max-width: 100%;
    }
    .contacto-mail .sweep {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 2px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: 0 50%;
      transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
      display: block;
    }
    .contacto-mail:hover {
      color: var(--accent);
    }
    .contacto-mail:hover .sweep {
      transform: scaleX(1);
    }
    .contacto-redes {
      list-style: none;
      display: grid;
      gap: var(--sp-xs);
    }
    .contacto-redes li {
      /* Grid en vez de flex: los usuarios quedan alineados entre sí */
      display: grid;
      grid-template-columns: 9ch auto;
      gap: var(--sp-s);
      align-items: baseline;
    }
    .contacto-redes span {
      font-family: var(--font-mono);
      font-weight: 500;
      letter-spacing: 0.06em;
      font-size: 0.66rem;
      color: var(--muted);
    }
    .contacto-redes a {
      font-weight: var(--w-bold);
      text-decoration: none;
      color: var(--fg);
      border-bottom: 1px solid var(--line);
      transition: color 0.25s ease, border-color 0.25s ease;
    }
    .contacto-redes a:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    @media (min-width: 860px) {
      .proceso-grid {
        grid-template-columns: 0.85fr 1.15fr;
      }
      /* En dos columnas sí tiene recorrido para acompañar a los pasos */
      .proceso-sticky {
        position: sticky;
        top: calc(var(--nav-h) + var(--sp-m));
      }
      .proceso-col {
        --rail-gap: clamp(1.75rem, 3.2vw, 3rem);
      }
      .proceso-rail,
      .paso-dot {
        display: block;
      }
      .proceso {
        padding-left: var(--rail-gap);
      }
      /* Los cuatro pasos cabían en una pantalla: sin altura no hay scroll que
         animar y la sección se veía quieta. Con este aire la lista supera el
         viewport y el riel, el contador y el paso activo tienen recorrido. */
      .paso {
        padding-block: clamp(2.5rem, 5.5vh, 4.25rem);
      }
      /* Con riel y contador acompañando, el contraste puede ser más marcado */
      body:not(.no-anim) .paso {
        opacity: 0.3;
      }

      /* A dos columnas: son siete líneas cortas y en una sola columna
         dejaban media sección en blanco a la derecha. */
      .incluye-lista {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: clamp(2.5rem, 6vw, 5rem);
      }

      .sobre-grid {
        grid-template-columns: 0.85fr 1.15fr;
        column-gap: clamp(2.5rem, 6vw, 5rem);
      }
      /* El texto es más alto que el lateral: que el título acompañe la
         lectura en lugar de quedarse arriba del todo. */
      .sobre-sticky {
        position: sticky;
        top: calc(var(--nav-h) + var(--sp-m));
      }
    }

    /* Escritorio: el carrusel se desliza con el scroll (GSAP scrub) */
    @media (min-width: 768px) {
      .trabajos-viewport {
        overflow: hidden;
      }
      .vcard {
        width: 320px;
      }
    }

    body.no-anim .trabajos-viewport {
      overflow-x: auto !important;
    }
    body.no-anim .paso-rule {
      transform: none !important;
    }
  </style>

  <Fragment slot="scripts">
    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ============================================================
         1. Smooth scroll (Lenis) sincronizado con ScrollTrigger
         ============================================================ */
      function initSmoothScroll() {
        if (reduced) return null;
        const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
        return lenis;
      }

      /* ============================================================
         2. Animaciones por sección
         ============================================================ */
      function initAnimations() {
        // Nav sólido al salir del inicio (evita solapes ilegibles).
        // Listener directo: es más fiable que un ScrollTrigger sin trigger.
        const nav = document.getElementById("nav");
        if (nav) {
          const syncNav = () => {
            nav.classList.toggle("is-scrolled", window.scrollY > 40);
          };
          syncNav();
          window.addEventListener("scroll", syncNav, { passive: true });
        }

        // Barra de progreso
        const bar = document.getElementById("scroll-progress-bar");
        if (bar) {
          gsap.to(bar, {
            scaleX: 1,
            ease: "none",
            scrollTrigger: { start: 0, end: "max", scrub: 0.3 },
          });
        }

        if (reduced) return;

        /* ---------- HERO: entrada por máscaras ---------- */
        gsap.set(".hero-title .word", { yPercent: 115 });
        const intro = gsap.timeline({ delay: 0.1 });
        intro.to(".hero-title .word", {
          yPercent: 0,
          duration: 1.05,
          ease: "power4.out",
          stagger: 0.055,
        });
        intro.from(
          "[data-hero]",
          { y: 20, opacity: 0, duration: 0.75, stagger: 0.1, ease: "power3.out" },
          "-=0.65"
        );

        // Hero: se aleja al scrollear
        gsap.to(".hero-inner", {
          yPercent: -12,
          opacity: 0.15,
          ease: "none",
          scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true },
        });

        /* ---------- TICKER: loop + empuje con el scroll ---------- */
        const track = document.getElementById("ticker-track");
        if (track) {
          const half = track.scrollWidth / 2;
          if (half > 0) {
            const loop = gsap.to(track, {
              x: -half,
              duration: 22,
              ease: "none",
              repeat: -1,
              modifiers: { x: (x) => `${parseFloat(x) % half}px` },
            });
            // El scroll acelera el ticker (efecto Framer)
            ScrollTrigger.create({
              start: 0,
              end: "max",
              onUpdate: (self) => {
                const v = gsap.utils.clamp(-6, 6, self.getVelocity() / 260);
                loop.timeScale(1 + Math.abs(v));
                gsap.to(loop, { timeScale: 1, duration: 0.7, overwrite: true });
              },
            });
          }
        }

        /* ---------- Reveals genéricos (solo opacidad) ---------- */
        gsap.set("[data-reveal]", { opacity: 0, y: 18 });
        ScrollTrigger.batch("[data-reveal]", {
          start: "top 92%",
          onEnter: (els) =>
            gsap.to(els, {
              opacity: 1,
              y: 0,
              duration: 0.85,
              ease: "power3.out",
              stagger: 0.08,
              overwrite: "auto",
            }),
        });

        /* ---------- Parallax continuo (data-speed) ---------- */
        gsap.utils.toArray<HTMLElement>("[data-speed]").forEach((el) => {
          const speed = parseFloat(el.dataset.speed || "0");
          if (!speed) return;
          gsap.fromTo(
            el,
            { y: speed * 60 },
            {
              y: -speed * 60,
              ease: "none",
              scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true },
            }
          );
        });

        /* ---------- TRABAJOS: carrusel que se desliza al bajar ---------- */
        const mm = gsap.matchMedia();
        mm.add("(min-width: 768px)", () => {
          const cards = document.getElementById("trabajos-track");
          const viewport = document.querySelector<HTMLElement>(".trabajos-viewport");
          if (!cards || !viewport) return;
          const overflow = () => Math.max(0, cards.scrollWidth - viewport.clientWidth);
          gsap.fromTo(
            cards,
            { x: 0 },
            {
              x: () => -overflow(),
              ease: "none",
              scrollTrigger: {
                trigger: ".s-trabajos",
                start: "top bottom",
                end: "bottom top",
                scrub: 0.6,
                invalidateOnRefresh: true,
              },
            }
          );
        });

        /* ---------- PROCESO: reglas que se dibujan y líneas que suben ---------- */
        const pasos = gsap.utils.toArray<HTMLElement>(".paso");
        const numEl = document.getElementById("proceso-num");
        pasos.forEach((paso) => {
          const rule = paso.querySelector(".paso-rule");
          const lines = paso.querySelectorAll(".line-inner");

          gsap.set(lines, { yPercent: 105, opacity: 0 });

          ScrollTrigger.create({
            trigger: paso,
            start: "top 88%",
            once: true,
            onEnter: () => {
              if (rule) gsap.to(rule, { scaleX: 1, duration: 1, ease: "power3.out" });
              gsap.to(lines, {
                yPercent: 0,
                opacity: 1,
                duration: 0.85,
                ease: "power3.out",
                stagger: 0.09,
              });
            },
          });
        });

        /* ---------- PROCESO: riel que se rellena y paso activo ----------
           Un único trigger sobre la columna gobierna riel, punto y contador.
           Antes cada paso llevaba el suyo y, como los cuatro entraban a la vez
           en pantalla, todo se disparaba junto y la sección quedaba quieta. */
        const proceso = document.querySelector<HTMLElement>(".proceso-col");
        const rellenoRiel = document.querySelector<HTMLElement>(".proceso-rail-fill");
        if (proceso && pasos.length) {
          const INICIO = "top 62%";
          const FIN = "bottom 65%";
          let activo = -1;

          const marcarActivo = (i: number) => {
            if (i === activo) return;
            activo = i;
            pasos.forEach((paso, n) => paso.classList.toggle("is-activo", n === i));
            const num = pasos[i]?.dataset.paso;
            if (numEl && num && numEl.textContent !== num) {
              gsap.fromTo(
                numEl,
                { yPercent: 45, opacity: 0 },
                { yPercent: 0, opacity: 1, duration: 0.45, ease: "power3.out" }
              );
              numEl.textContent = num;
            }
          };

          if (rellenoRiel) {
            gsap.to(rellenoRiel, {
              scaleY: 1,
              ease: "none",
              scrollTrigger: { trigger: proceso, start: INICIO, end: FIN, scrub: 0.5 },
            });
          }

          ScrollTrigger.create({
            trigger: proceso,
            start: INICIO,
            end: FIN,
            // El primer paso queda activo antes de entrar y el último al salir:
            // así nunca se ven los cuatro atenuados a la vez.
            onUpdate: (self) =>
              marcarActivo(Math.min(pasos.length - 1, Math.floor(self.progress * pasos.length))),
            onLeaveBack: () => marcarActivo(0),
          });

          marcarActivo(0);
        }

        /* ---------- SOBRE MÍ: párrafos que suben por máscara ---------- */
        const sobreLines = gsap.utils.toArray<HTMLElement>(".s-sobre .line-inner");
        if (sobreLines.length) {
          gsap.set(sobreLines, { yPercent: 105, opacity: 0 });
          ScrollTrigger.create({
            trigger: ".s-sobre",
            start: "top 78%",
            once: true,
            onEnter: () =>
              gsap.to(sobreLines, {
                yPercent: 0,
                opacity: 1,
                duration: 0.95,
                ease: "power3.out",
                stagger: 0.12,
              }),
          });
        }

        /* ---------- CONTACTO: titular por máscaras ---------- */
        const cWords = gsap.utils.toArray<HTMLElement>(".word--c");
        if (cWords.length) {
          gsap.set(cWords, { yPercent: 115 });
          ScrollTrigger.create({
            trigger: ".s-contacto",
            start: "top 72%",
            once: true,
            onEnter: () =>
              gsap.to(cWords, { yPercent: 0, duration: 1, ease: "power4.out", stagger: 0.045 }),
          });
        }
      }

      /* ============================================================
         3. Facade de video: al hacer clic, carga el iframe
         ============================================================ */
      function initVideoFacade() {
        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          const media = target.closest<HTMLElement>(".vmedia[data-embed]");
          if (!media) return;
          const src = media.getAttribute("data-embed");
          if (!src) return;
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.className = "vmedia-iframe";
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "");
          iframe.setAttribute("title", media.getAttribute("aria-label") ?? "Video");
          media.replaceWith(iframe);
          ScrollTrigger.refresh();
        });

        // Miniatura de reserva: si la de proporción original no existe para
        // ese video, se pide la 4:3. El evento `error` no burbujea, de ahí
        // la fase de captura.
        document.addEventListener(
          "error",
          (event) => {
            const img = event.target as HTMLElement;
            if (!(img instanceof HTMLImageElement)) return;
            const reserva = img.dataset.reserva;
            if (!reserva || img.src === reserva) return;
            img.src = reserva;
          },
          true,
        );
      }

      /* ============================================================
         4. Anchors con smooth scroll
         ============================================================ */
      function initAnchors(lenis: Lenis | null) {
        // Altura real del nav: el destino nunca queda tapado por él
        const navOffset = () => {
          const nav = document.getElementById("nav");
          return nav ? -nav.getBoundingClientRect().height : 0;
        };
        document.querySelectorAll<HTMLAnchorElement>("a[data-scroll]").forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href");
            if (!id || !id.startsWith("#")) return;
            const el = document.querySelector(id);
            if (!el) return;
            e.preventDefault();
            const offset = id === "#top" ? 0 : navOffset();
            if (lenis) lenis.scrollTo(el as HTMLElement, { offset });
            else (el as HTMLElement).scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
          });
        });
      }

      /* ---------- Arranque (con red de seguridad de legibilidad) ---------- */
      if (reduced) document.body.classList.add("no-anim");
      try {
        const lenis = initSmoothScroll();
        initAnimations();
        initVideoFacade();
        initAnchors(lenis);
        window.addEventListener("load", () => ScrollTrigger.refresh());
      } catch (err) {
        // Si algo falla, el contenido nunca se queda invisible
        document.body.classList.add("no-anim");
        console.error(err);
      }
    </script>
  </Fragment>
</Immersive>
