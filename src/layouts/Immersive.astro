---
import { PERFIL, CONTACTO } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${PERFIL.nombre}, ${PERFIL.rol}`,
  description = PERFIL.subtitular,
  ogImage = "/og.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://javiermiz.github.io");
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={PERFIL.nombre} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <meta name="theme-color" content="#e7e4dd" />
  </head>

  <body>
    <!-- Retícula de fondo: estructura techie, sin competir con el texto -->
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>

    <header class="nav" id="nav">
      <a href="#top" class="nav-logo" data-scroll>{PERFIL.nombre}</a>
      <nav class="nav-links">
        <a href="#trabajos" data-scroll>Trabajos</a>
        <a href="#sobre" data-scroll>Sobre mí</a>
        <a href="#contacto" data-scroll>Contacto</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>&copy; {currentYear} {PERFIL.nombre}</p>
        <div class="footer-links">
          <a href={CONTACTO.instagram.url} target="_blank" rel="noopener">Instagram</a>
          <a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">TikTok</a>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --font-display: "Helvetica Neue", Helvetica, Arial, sans-serif;
        --font-body: "Helvetica Neue", Helvetica, Arial, sans-serif;
        --font-mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;

        /* Tema claro piedra/papel (no blanco puro) */
        --bg: #e8e5de;
        --bg-2: #ddd9d0;
        --fg: #14131a;
        /* Texto secundario con contraste suficiente (>6:1 sobre el papel) */
        --muted: #4f4c45;
        --line: rgba(20, 19, 26, 0.14);
        --accent: #2438d1;
        --accent-2: #d4441c;

        --maxw: 1320px;
        --pad: clamp(1.25rem, 4vw, 3.5rem);

        --w-black: 900;
        --w-bold: 800;
        --w-med: 600;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-body);
        font-size: 18px;
        color: var(--fg);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      html.lenis,
      html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }

      body {
        background: var(--bg);
        min-height: 100vh;
        overflow-x: hidden;
        position: relative;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-display);
        font-weight: var(--w-black);
        text-transform: uppercase;
        line-height: 0.94;
        letter-spacing: -0.035em;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--accent);
        color: #fff;
      }

      /* Retícula fija muy tenue: da estructura sin restar legibilidad */
      .grid-bg {
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background-image:
          linear-gradient(to right, rgba(20, 19, 26, 0.055) 1px, transparent 1px);
        background-size: calc(100% / 6) 100%;
      }

      .grain {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.06;
        mix-blend-mode: multiply;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }

      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        z-index: 50;
        background: transparent;
      }
      .scroll-progress span {
        display: block;
        height: 100%;
        width: 100%;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: 0 50%;
      }

      /* Nav */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: clamp(0.9rem, 2.2vw, 1.4rem) var(--pad);
        color: var(--fg);
      }
      /* Fondo sólido al scrollear: el contenido que pasa por debajo
         nunca se mezcla con el nav (legibilidad). */
      .nav::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--bg);
        border-bottom: 1px solid transparent;
        opacity: 0;
        transition: opacity 0.3s ease, border-color 0.3s ease;
      }
      .nav.is-scrolled::before {
        opacity: 0.97;
        border-bottom-color: var(--line);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }
      .nav-logo {
        font-family: var(--font-display);
        font-weight: var(--w-black);
        text-transform: uppercase;
        letter-spacing: -0.03em;
        font-size: 1.05rem;
        text-decoration: none;
        color: var(--fg);
      }
      .nav-links {
        display: flex;
        gap: clamp(1rem, 3vw, 2.25rem);
      }
      .nav-links a {
        position: relative;
        font-family: var(--font-mono);
        font-weight: 500;
        letter-spacing: 0.03em;
        font-size: 0.72rem;
        text-decoration: none;
        color: var(--muted);
        transition: color 0.25s ease;
      }
      .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: 100% 50%;
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .nav-links a:hover {
        color: var(--fg);
      }
      .nav-links a:hover::after {
        transform: scaleX(1);
        transform-origin: 0 50%;
      }
      /* En pantallas estrechas el logo y el menú se apretaban: se reduce
         el menú para que nada quede pegado ni se corte. */
      @media (max-width: 600px) {
        .nav-logo {
          font-size: 0.95rem;
        }
        .nav-links {
          gap: 1.1rem;
        }
        .nav-links a {
          font-size: 0.68rem;
        }
        .nav-links a:first-child {
          display: none;
        }
      }

      /* Footer */
      .site-footer {
        position: relative;
        z-index: 2;
        border-top: 1px solid var(--line);
        padding: var(--pad);
      }
      .footer-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .footer-inner p,
      .footer-links a {
        font-family: var(--font-mono);
        font-weight: 500;
        letter-spacing: 0.03em;
        font-size: 0.72rem;
        color: var(--muted);
      }
      .footer-links {
        display: flex;
        gap: 1.5rem;
      }
      .footer-links a {
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--accent);
      }

      /* Sin animación (reduced-motion o fallo de JS): todo legible */
      body.no-anim [data-reveal],
      body.no-anim [data-speed],
      body.no-anim .hero-title .word,
      body.no-anim .line-inner {
        opacity: 1 !important;
        transform: none !important;
      }
      body.no-anim .s-word {
        color: var(--fg) !important;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>

    <slot name="scripts" />
  </body>
</html>
