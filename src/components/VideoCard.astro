---
import type { Video } from "../data/portfolio";

interface Props {
  video: Video;
}

const { video } = Astro.props;

/* Los videos se incrustan desde su plataforma; nada se aloja en este sitio. */
function youtubeThumb(id: string) {
  return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
}

let thumb = video.thumbnail ?? "";
let embed = ""; // src del iframe para reproducir en línea
let enlace = ""; // URL para abrir la publicación en otra plataforma

if (video.fuente === "youtube") {
  thumb = video.thumbnail ?? youtubeThumb(video.videoId);
  embed = `https://www.youtube-nocookie.com/embed/${video.videoId}?autoplay=1&rel=0&playsinline=1`;
  enlace = `https://youtu.be/${video.videoId}`;
} else if (video.fuente === "vimeo") {
  embed = `https://player.vimeo.com/video/${video.videoId}?autoplay=1`;
  enlace = `https://vimeo.com/${video.videoId}`;
} else {
  // instagram / tiktok: se abre la publicación original
  enlace = video.videoId;
}

const puedeIncrustar = embed !== "";
---

<article class="video-card">
  {
    puedeIncrustar ? (
      <button
        type="button"
        class="video-media"
        data-embed={embed}
        aria-label={`Reproducir: ${video.titulo}`}
      >
        <img src={thumb} alt={`Miniatura de ${video.titulo}`} loading="lazy" />
        <span class="video-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </button>
    ) : (
      <a
        class="video-media"
        href={enlace}
        target="_blank"
        rel="noopener"
        aria-label={`Ver en ${video.fuente}: ${video.titulo}`}
      >
        <img src={thumb} alt={`Miniatura de ${video.titulo}`} loading="lazy" />
        <span class="video-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </a>
    )
  }

  <div class="video-info">
    <div class="video-meta">
      <span class="video-categoria">{video.categoria}</span>
      <span class="video-formato">{video.formato}</span>
    </div>
    <h3 class="video-titulo">{video.titulo}</h3>
    <p class="video-marca">{video.marca}</p>
    <p class="video-descripcion">{video.descripcion}</p>
  </div>
</article>

<script>
  // Facade: al hacer clic, sustituye la miniatura por el reproductor
  // incrustado. Así no se cargan iframes de terceros hasta que hacen falta.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const media = target.closest<HTMLElement>(".video-media[data-embed]");
    if (!media) return;

    const src = media.getAttribute("data-embed");
    if (!src) return;

    const iframe = document.createElement("iframe");
    iframe.src = src;
    iframe.className = "video-iframe";
    iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
    iframe.setAttribute("allowfullscreen", "");
    iframe.setAttribute("title", media.getAttribute("aria-label") ?? "Video");

    media.replaceWith(iframe);
  });
</script>

<style>
  .video-card {
    display: block;
  }

  .video-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
    cursor: pointer;
    /* reset de <button> + brutalist */
    padding: 0;
    color: inherit;
    text-decoration: none;
    border: var(--border-thick) solid var(--color-border);
    box-shadow: var(--shadow-hard);
    transition: transform var(--transition-elegant), box-shadow var(--transition-elegant);
  }

  .video-media:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 var(--color-border);
  }

  .video-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-elegant), filter var(--transition-elegant);
  }

  .video-media:hover img {
    transform: scale(1.03);
    filter: brightness(0.95);
  }

  .video-metrica {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    background: rgba(250, 248, 243, 0.92);
    color: var(--color-text-primary);
    font-size: var(--text-2xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    padding: 2px var(--space-2);
    border-radius: 999px;
  }

  .video-play {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: #fff;
    border: var(--border-thin) solid var(--color-border);
    transition: transform var(--transition-elegant);
  }

  .video-media:hover .video-play {
    transform: scale(1.08);
  }

  .video-play svg {
    width: 20px;
    height: 20px;
    margin-left: 2px;
  }

  /* Reproductor incrustado que reemplaza la miniatura */
  :global(.video-iframe) {
    width: 100%;
    aspect-ratio: 9 / 16;
    border: var(--border-thick) solid var(--color-border);
    display: block;
    background: #000;
  }

  .video-info {
    padding-top: var(--space-4);
  }

  .video-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .video-categoria {
    font-size: var(--text-2xs);
    color: #fff;
    background: var(--color-primary);
    padding: 2px var(--space-2);
    border: var(--border-thin) solid var(--color-border);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    font-weight: var(--font-bold);
  }

  .video-formato {
    font-size: var(--text-2xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
  }

  .video-titulo {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    margin-bottom: 0;
    text-wrap: balance;
  }

  .video-marca {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .video-descripcion {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }
</style>
