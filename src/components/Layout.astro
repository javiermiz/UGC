---
import { PERFIL, CONTACTO } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${PERFIL.nombre}, ${PERFIL.rol}`,
  description = PERFIL.subtitular,
  ogImage = "/og.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://javiermiz.github.io");
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={PERFIL.nombre} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <meta name="theme-color" content="#ffffff" />
  </head>

  <body>
    <header class="site-header">
      <div class="header-content">
        <a href="/" class="site-logo">{PERFIL.nombre}</a>
        <nav class="main-nav">
          <!-- El link "Trabajos" se reactiva cuando la sección deje de estar oculta -->
          <a href="/#servicios">Servicios</a>
          <a href="/#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <p>&copy; {currentYear} {PERFIL.nombre}</p>
        <div class="footer-links">
          <a href={CONTACTO.instagram.url} target="_blank" rel="noopener">
            Instagram
          </a>
          <a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">
            TikTok
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Spectral";
    src: url("/fonts/Spectral-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Spectral";
    src: url("/fonts/Spectral-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Design tokens (sistema brutalist): alto contraste, tipografía bold,
     bordes gruesos negros, sombras duras (hard offset), esquinas rectas. */
  :root {
    /* Tipografía grotesca pesada, sin web fonts (rápida y contundente) */
    --font-serif: "Helvetica Neue", Helvetica, Arial, "Arial Black", sans-serif;
    --font-serif-body: "Helvetica Neue", Helvetica, Arial, sans-serif;

    --color-primary: #ff2d1a; /* rojo eléctrico */
    --color-primary-hover: #000000;

    --color-accent: #ffe500; /* amarillo brutalist para bloques/realces */

    --color-text-primary: #000000;
    --color-text-secondary: #111111;
    --color-text-muted: #555555;
    --color-text-light: #777777;
    --color-text-body: #111111;

    --color-bg-primary: #ffffff;
    --color-bg-secondary: #f0f0ee;
    --color-bg-tertiary: #e6e6e2;
    --color-site-bg: #ffffff;

    /* Todo borde es negro y grueso en brutalist */
    --color-border: #000000;
    --color-border-light: #000000;
    --color-border-medium: #000000;
    --color-border-subtle: #000000;

    --text-2xs: 0.7rem;
    --text-xs: 0.8rem;
    --text-sm: 0.9rem;
    --text-base: 1.05rem;
    --text-lg: 1.4rem;
    --text-xl: 2rem;
    --text-2xl: 2.75rem;
    --text-3xl: 3.5rem;
    --text-4xl: 5rem;

    --font-light: 400;
    --font-normal: 500;
    --font-medium: 700;
    --font-semibold: 800;
    --font-bold: 900;

    --line-height-tight: 0.95;
    --line-height-snug: 1.1;
    --line-height-normal: 1.4;
    --line-height-relaxed: 1.55;

    --letter-spacing-tight: -0.03em;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 0.03em;
    --letter-spacing-wider: 0.1em;

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;

    --content-spacing-xs: var(--space-4);
    --content-spacing-sm: var(--space-6);
    --content-spacing-md: var(--space-8);
    --content-spacing-lg: var(--space-12);

    /* Layout system (Section / Container) */
    --container-pad: var(--space-5);
    --section-space: var(--space-12);

    /* Grosor de bordes brutalist */
    --border-thin: 2px;
    --border-thick: 4px;

    /* Sombras duras (sin blur) */
    --shadow-subtle: 4px 4px 0 var(--color-border);
    --shadow-hard: 6px 6px 0 var(--color-border);
    --shadow-elegant: 8px 8px 0 var(--color-border);

    --transition-elegant: 0.1s ease-out;

    --radius-elegant: 0; /* brutalist: sin esquinas redondeadas */

    /* Contenedor wide */
    --max-width-content: 1200px;
    --max-width-wide: 1360px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-serif-body);
    font-size: 18px;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-body);
    background-color: var(--color-site-bg);
    letter-spacing: var(--letter-spacing-normal);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    font-weight: var(--font-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    text-transform: uppercase;
    margin-bottom: var(--content-spacing-sm);
  }

  body {
    background-color: var(--color-site-bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 0;
  }

  /* Header */
  .site-header {
    padding: var(--space-4) 0;
    background: var(--color-bg-primary);
    border-bottom: var(--border-thick) solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--container-pad);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .site-logo {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: var(--letter-spacing-tight);
    white-space: nowrap;
    transition: color var(--transition-elegant);
  }

  .site-logo:hover {
    color: var(--color-primary);
  }

  .main-nav {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .main-nav a {
    color: var(--color-text-primary);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    white-space: nowrap;
    transition: color var(--transition-elegant);
  }

  .main-nav a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  /* Main: solo maneja el ritmo vertical entre secciones.
     El ancho y el padding lateral los ponen los <Container>. */
  .main-content {
    flex: 1;
    width: 100%;
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    gap: var(--section-space);
    padding-block: var(--section-space);
  }

  /* ------------------------------------------------------------------ */
  /* Primitivas del sistema de diseño                                   */
  /* ------------------------------------------------------------------ */

  /* Título de sección: bloque negro con sombra dura roja (brutalist). */
  .section-title {
    display: inline-block;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-tight);
    line-height: 1;
    color: #fff;
    background: var(--color-text-primary);
    padding: var(--space-3) var(--space-4);
    border: var(--border-thick) solid var(--color-border);
    box-shadow: var(--shadow-hard-accent, 6px 6px 0 var(--color-primary));
    margin-bottom: var(--space-8);
  }

  /* Carrusel: scroll horizontal en móvil, grid en pantallas grandes.
     En móvil sangra hasta el borde de la pantalla (full-bleed) para que
     se note que hay más contenido a los lados. */
  .carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--card, 74%);
    gap: var(--space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    margin-inline: calc(-1 * var(--container-pad));
    padding-inline: var(--container-pad);
    padding-bottom: var(--space-2);
    scrollbar-width: none;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .carousel > * {
    scroll-snap-align: start;
  }

  @media (min-width: 640px) {
    .carousel {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      padding-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel {
      scroll-behavior: auto;
    }
  }

  /* Footer */
  .site-footer {
    border-top: var(--border-thick) solid var(--color-border);
    background: var(--color-bg-primary);
    padding: var(--space-6) 0;
    margin-top: auto;
  }

  .footer-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--container-pad);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-content p {
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .footer-links {
    display: flex;
    gap: var(--content-spacing-md);
  }

  .footer-links a {
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    transition: color var(--transition-elegant);
  }

  .footer-links a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    :root {
      --container-pad: var(--space-6);
      --section-space: var(--space-16);
    }

    .section-title {
      font-size: var(--text-xl);
      margin-bottom: var(--space-8);
    }
  }

  @media (min-width: 481px) {
    .site-header {
      padding: var(--content-spacing-xs) 0;
    }

    .site-logo {
      font-size: var(--text-xl);
    }

    .main-nav {
      gap: var(--content-spacing-md);
    }

    .main-nav a {
      font-size: var(--text-sm);
    }

    .site-footer {
      padding: var(--content-spacing-md) 0;
    }

    .footer-content p,
    .footer-links a {
      font-size: var(--text-sm);
    }
  }
</style>
