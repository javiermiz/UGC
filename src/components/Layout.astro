---
import { PERFIL, CONTACTO } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${PERFIL.nombre} — ${PERFIL.rol}`,
  description = PERFIL.subtitular,
  ogImage = "/og.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://javiermiz.github.io");
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={PERFIL.nombre} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <meta name="theme-color" content="#faf8f3" />
  </head>

  <body>
    <header class="site-header">
      <div class="header-content">
        <a href="/" class="site-logo">{PERFIL.nombre}</a>
        <nav class="main-nav">
          <a href="/#trabajos">Trabajos</a>
          <a href="/#servicios">Servicios</a>
          <a href="/#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <p>&copy; {currentYear} {PERFIL.nombre}</p>
        <div class="footer-links">
          <a href={CONTACTO.instagram.url} target="_blank" rel="noopener">
            Instagram
          </a>
          <a href={CONTACTO.tiktok.url} target="_blank" rel="noopener">
            TikTok
          </a>
          <a href="https://javiermiz.github.io" target="_blank" rel="noopener">
            Blog
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Spectral";
    src: url("/fonts/Spectral-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Spectral";
    src: url("/fonts/Spectral-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Design tokens — mismos que javiermiz.github.io */
  :root {
    --font-serif: "Spectral", serif;
    --font-serif-body: "Spectral", serif;

    --color-primary: #dc2626;
    --color-primary-hover: #b91c1c;

    --color-text-primary: #171717;
    --color-text-secondary: #404040;
    --color-text-muted: #737373;
    --color-text-light: #a3a3a3;
    --color-text-body: #262626;

    --color-bg-primary: #ffffff;
    --color-bg-secondary: #fafafa;
    --color-bg-tertiary: #f5f5f5;
    --color-site-bg: #faf8f3;

    --color-border-light: #bbbbbb;
    --color-border-medium: #d4d4d4;
    --color-border-subtle: #f5f5f5;

    --text-2xs: 0.625rem;
    --text-xs: 0.8rem;
    --text-sm: 0.9rem;
    --text-base: 1.1rem;
    --text-lg: 1.25rem;
    --text-xl: 1.4rem;
    --text-2xl: 1.75rem;
    --text-3xl: 2.25rem;

    --font-light: 300;
    --font-normal: 400;
    --font-medium: 500;
    --font-semibold: 600;
    --font-bold: 700;

    --line-height-tight: 1.25;
    --line-height-snug: 1.375;
    --line-height-normal: 1.5;
    --line-height-relaxed: 1.65;

    --letter-spacing-tight: -0.025em;
    --letter-spacing-normal: 0.2px;
    --letter-spacing-wide: 0.025em;
    --letter-spacing-wider: 0.05em;

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;

    --content-spacing-xs: var(--space-4);
    --content-spacing-sm: var(--space-6);
    --content-spacing-md: var(--space-8);
    --content-spacing-lg: var(--space-12);

    --shadow-subtle: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    --shadow-elegant: 0 8px 30px rgba(0, 0, 0, 0.06);

    --transition-elegant: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    --radius-elegant: 0.375rem;

    --max-width-content: 860px;
    --max-width-wide: 1200px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-serif-body);
    font-size: 22px;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-body);
    background-color: var(--color-bg-primary);
    letter-spacing: var(--letter-spacing-normal);
    scroll-behavior: smooth;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    font-weight: var(--font-semibold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--content-spacing-sm);
  }

  body {
    background-color: var(--color-site-bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 0;
  }

  /* Textura de ruido igual que el blog */
  body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.3;
    z-index: -1;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  /* Header */
  .site-header {
    padding: var(--space-4) 0;
    box-shadow: var(--shadow-subtle);
  }

  .header-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .site-logo {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
    text-decoration: none;
    letter-spacing: var(--letter-spacing-tight);
    white-space: nowrap;
    transition: color var(--transition-elegant);
  }

  .main-nav {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  .main-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-2xs);
    white-space: nowrap;
    transition: color var(--transition-elegant);
  }

  .main-nav a:hover {
    color: var(--color-primary);
  }

  /* Main */
  .main-content {
    flex: 1;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: var(--space-10) var(--space-4);
    width: 100%;
    min-height: 50vh;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--color-border-subtle);
    padding: var(--space-4) 0;
    margin-top: auto;
  }

  .footer-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-content p {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--letter-spacing-wide);
  }

  .footer-links {
    display: flex;
    gap: var(--content-spacing-md);
  }

  .footer-links a {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color var(--transition-elegant);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  @media (min-width: 481px) {
    .site-header {
      padding: var(--content-spacing-xs) 0;
    }

    .site-logo {
      font-size: var(--text-xl);
    }

    .main-nav {
      gap: var(--content-spacing-md);
    }

    .main-nav a {
      font-size: var(--text-sm);
    }

    .site-footer {
      padding: var(--content-spacing-md) 0;
    }

    .footer-content {
      padding: 0 var(--content-spacing-sm);
    }

    .footer-content p,
    .footer-links a {
      font-size: var(--text-sm);
    }
  }
</style>
