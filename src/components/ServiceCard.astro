---
import type { Servicio } from "../data/portfolio";

interface Props {
  servicio: Servicio;
}

const { servicio } = Astro.props;
---

<article class="servicio">
  <header class="servicio-header">
    <h3 class="servicio-titulo">{servicio.titulo}</h3>
    <span class="servicio-precio">{servicio.precio}</span>
  </header>

  <p class="servicio-descripcion">{servicio.descripcion}</p>

  <ul class="servicio-entregables">
    {servicio.entregables.map((item) => <li>{item}</li>)}
  </ul>

  <a class="servicio-cta" href="#contacto">Pedir cotización</a>
</article>

<style>
  .servicio {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-elegant);
  }

  .servicio-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .servicio-titulo {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    margin-bottom: 0;
  }

  .servicio-precio {
    font-size: var(--text-xs);
    color: var(--color-primary);
    white-space: nowrap;
    letter-spacing: var(--letter-spacing-wide);
  }

  .servicio-descripcion {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .servicio-entregables {
    list-style: none;
    margin-bottom: var(--space-5);
  }

  .servicio-entregables li {
    font-size: var(--text-sm);
    color: var(--color-text-body);
    padding-left: var(--space-4);
    position: relative;
    margin-bottom: var(--space-1);
  }

  .servicio-entregables li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: var(--font-bold);
  }

  .servicio-cta {
    margin-top: auto;
    align-self: flex-start;
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    text-decoration: none;
    letter-spacing: var(--letter-spacing-wide);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-elegant);
    color: var(--color-primary);
    background-color: transparent;
    transition: all var(--transition-elegant);
  }

  .servicio-cta:hover {
    background-color: var(--color-primary);
    color: #fff;
  }
</style>
