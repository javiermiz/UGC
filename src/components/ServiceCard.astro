---
import type { Servicio } from "../data/portfolio";

interface Props {
  servicio: Servicio;
}

const { servicio } = Astro.props;
---

<article class="servicio">
  <header class="servicio-header">
    <h3 class="servicio-titulo">{servicio.titulo}</h3>
    <span class="servicio-precio">{servicio.precio}</span>
  </header>

  <p class="servicio-descripcion">{servicio.descripcion}</p>

  <ul class="servicio-entregables">
    {servicio.entregables.map((item) => <li>{item}</li>)}
  </ul>

  <a class="servicio-cta" href="#contacto">Pedir cotización</a>
</article>

<style>
  .servicio {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background-color: var(--color-bg-primary);
    border: var(--border-thick) solid var(--color-border);
    box-shadow: var(--shadow-hard);
  }

  .servicio-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .servicio-titulo {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0;
  }

  .servicio-precio {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: #fff;
    background: var(--color-primary);
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin) solid var(--color-border);
    white-space: nowrap;
  }

  .servicio-descripcion {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    line-height: var(--line-height-normal);
  }

  .servicio-entregables {
    list-style: none;
    margin-bottom: var(--space-6);
  }

  .servicio-entregables li {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-body);
    padding-left: var(--space-5);
    position: relative;
    margin-bottom: var(--space-2);
  }

  .servicio-entregables li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.7em;
    height: 0.7em;
    background: var(--color-primary);
    border: 2px solid var(--color-border);
  }

  .servicio-cta {
    margin-top: auto;
    align-self: flex-start;
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    color: #fff;
    background-color: var(--color-text-primary);
    border: var(--border-thick) solid var(--color-border);
    box-shadow: var(--shadow-subtle);
    transition: transform var(--transition-elegant), box-shadow var(--transition-elegant), background-color var(--transition-elegant);
  }

  .servicio-cta:hover {
    background-color: var(--color-primary);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--color-border);
  }
</style>
